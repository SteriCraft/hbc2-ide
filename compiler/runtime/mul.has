; C runtime: multiplication (ABI.md section 11). The low half of the
; product is the same for signed and unsigned values.

; [a:b] = [c:d] * [a:b]
; Shift and add, from the top bit of the right operand:
; result = result * 2, plus the left operand when the bit is 1.
__mul:
    mov i, 0                    ; [i:j] = result
    mov j, 0
    mov x, 16                   ; bits to do
__mul_bit:
    shl j
    adc i, i                    ; result * 2
    shl b
    adc a, a                    ; C = next bit of the right operand
    jmc __mul_add
__mul_next:
    dec x
    jmz __mul_done
    jmp __mul_bit
__mul_add:
    add j, d
    adc i, c
    jmp __mul_next
__mul_done:
    mov a, i
    mov b, j
    ret

; [c:d]:[a:b] = [x:y]:[i:j] * [c:d]:[a:b]
; Both operands go on the stack; the result builds up in [c:d]:[a:b],
; one byte of the right operand at a time (in x).
__mull:
    psh j, i, y, x              ; left: [sp + 4] (MSB) .. [sp + 7]
    psh b, a, d, c              ; right: [sp] (MSB) .. [sp + 3]
    mov a, 0
    mov b, 0
    mov c, 0
    mov d, 0
    lod x, [sp]
    cal __mull_byte
    lod x, [sp + 1]
    cal __mull_byte
    lod x, [sp + 2]
    cal __mull_byte
    lod x, [sp + 3]
    cal __mull_byte
    asp 8
    ret

; result = result * 256 + x * left, with the left operand at [sp + 6] (MSB)
; .. [sp + 9] (above the return address)
__mull_byte:
    mov y, 8
__mull_bit:
    shl b
    adc a, a
    adc d, d
    adc c, c                    ; result * 2
    shl x                       ; C = next bit
    jmc __mull_add
__mull_next:
    dec y
    jmz __mull_byte_done
    jmp __mull_bit
__mull_add:
    add b, [sp + 9]
    adc a, [sp + 8]
    adc d, [sp + 7]
    adc c, [sp + 6]
    jmp __mull_next
__mull_byte_done:
    ret
