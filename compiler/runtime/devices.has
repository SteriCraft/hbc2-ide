; The devices for C programs (included by crt0.has): the port variables
; of the library's drivers, under C names (declared in hbc2.h):
;     extern unsigned char monitor_port, rtc_port, keyboard_port, eeprom_port;
; 0 = no such device. crt0_devices sets them from the device table that
; dev_init filled (lib/asm/devices.has): the first display, the first
; RTC, the first keyboard and the first EEPROM (mass storage with the
; EEPROM's product ID, 0x0004: an SD card has other commands).

.include "../lib/asm/devices.has"

.data _monitor_port 0
.data _keyboard_port 0
.data _rtc_port 0
.data _eeprom_port 0

; Changes every register but i, and the flags.
crt0_devices:
    mov a, DEV_DISPLAY
    mov b, DEV_ANY
    cal dev_port
    str _monitor_port, d
    mov a, DEV_SYSTEM
    mov b, DEV_RTC
    cal dev_port
    str _rtc_port, d
    mov a, DEV_INPUT
    mov b, DEV_KEYBOARD
    cal dev_port
    str _keyboard_port, d
    mov a, DEV_STORAGE
    mov b, DEV_ANY
    mov j, 0                    ; j = which storage device
crt0_devices_storage:
    mov c, j
    cal dev_find
    jmc crt0_devices_none
    inc j
    lod c, [x:y + 2]            ; product ID: 0x0004
    cmp c, 0x00
    jme crt0_devices_lsb
    jmp crt0_devices_storage
crt0_devices_lsb:
    lod c, [x:y + 3]
    cmp c, 0x04
    jme crt0_devices_eeprom
    jmp crt0_devices_storage
crt0_devices_none:                ; d = 0
crt0_devices_eeprom:
    str _eeprom_port, d
    ret

