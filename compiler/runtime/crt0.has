; C startup code, at $0x0000 (see compiler/ABI.md, section 8).
; Clears the .bss area, calls main, then waits at __exit with main's
; result in [a:b]. Interrupt handlers keep running there.

_start:
    wsp $0xFE00                 ; the reset value, set again for a restart
    mov x, __bss_start.msb      ; [x:y] = first byte of the .bss area
    mov y, __bss_start.lsb
    mov a, 0
crt0_clear:
    cmp x, __bss_end.msb
    jme crt0_clear_low
    jmp crt0_clear_byte
crt0_clear_low:
    cmp y, __bss_end.lsb
    jme crt0_cleared
crt0_clear_byte:
    str [x:y], a
    inc y
    jmc crt0_clear_carry
    jmp crt0_clear
crt0_clear_carry:
    inc x
    jmp crt0_clear
crt0_cleared:
    cal _main
__exit:                         ; [a:b] = main's result, or exit's argument
    hlt
    jmp __exit
