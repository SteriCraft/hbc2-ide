; C runtime: shifts (ABI.md section 11). The count is in b (a must be 0,
; and the high bytes of a long count are ignored). A count of the size of
; the value or more gives 0, or -1 / 0 for a negative signed value.
;
; Whole bytes first (a byte move each), then the bits that are left.
; There is no rotate through carry: for a right shift, each lower byte gets
; the bit leaving the byte above it with a jump on C (shr keeps C).

; ----- 16 bits: value in [c:d], count in [a:b], result in [a:b]

__shl:
    or a, 0
    jmz __shl_count
    mov b, 16
__shl_count:
    cmp b, 15
    jms __shift_zero
    cmp b, 8
    jmf __shl_bits
    mov c, d                    ; 8 bits: a byte move
    mov d, 0
    sub b, 8
    jmz __shift_done
__shl_high:                     ; only c is left to shift
    shl c
    dec b
    jmz __shift_done
    jmp __shl_high
__shl_bits:
    or b, 0
    jmz __shift_done
__shl_bit:
    shl d
    adc c, c
    dec b
    jmz __shift_done
    jmp __shl_bit
__shift_done:
    mov a, c
    mov b, d
    ret
__shift_zero:
    mov a, 0
    mov b, 0
    ret

__shru:                         ; logical
    or a, 0
    jmz __shru_count
    mov b, 16
__shru_count:
    cmp b, 15
    jms __shift_zero
    cmp b, 8
    jmf __shru_bits
    mov d, c                    ; 8 bits: a byte move
    mov c, 0
    sub b, 8
    jmz __shift_done
__shru_low:                     ; only d is left to shift
    shr d
    dec b
    jmz __shift_done
    jmp __shru_low
__shru_bits:
    or b, 0
    jmz __shift_done
__shru_bit:
    asr c                       ; C = bit leaving c
    and c, 0x7F                 ; and keeps C
    shr d                       ; shr keeps C
    jmc __shru_one
    dec b
    jmz __shift_done
    jmp __shru_bit
__shru_one:
    or d, 0x80
    dec b
    jmz __shift_done
    jmp __shru_bit

__shr:                          ; arithmetic: the sign bit is copied
    or a, 0
    jmz __shr_count
    mov b, 16
__shr_count:
    cmp b, 15
    jms __shr_sign
    cmp b, 8
    jmf __shr_bits
    mov d, c                    ; 8 bits: a byte move, c = 0 or -1
    shl c                       ; C = sign
    mov c, 0
    sbb c, 0
    sub b, 8
    jmz __shift_done
__shr_low:                      ; d's bit 7 is the sign: asr d alone
    asr d
    dec b
    jmz __shift_done
    jmp __shr_low
__shr_bits:
    or b, 0
    jmz __shift_done
__shr_bit:
    asr c
    shr d
    jmc __shr_one
    dec b
    jmz __shift_done
    jmp __shr_bit
__shr_one:
    or d, 0x80
    dec b
    jmz __shift_done
    jmp __shr_bit
__shr_sign:                     ; 0, or -1 for a negative value
    mov b, 0
    or c, 0
    jmn __shr_minus
    mov a, 0
    ret
__shr_minus:
    mov a, 0xFF
    mov b, 0xFF
    ret

; ----- 32 bits: value in [x:y]:[i:j], count in b, result in [c:d]:[a:b]

; [c:d]:[a:b] = value, x = count (32 when a was not 0)
__shift_setl:
    or a, 0
    jmz __shift_setl_count
    mov b, 32
__shift_setl_count:
    mov a, b
    mov c, x
    mov d, y
    mov x, a
    mov a, i
    mov b, j
    ret

__shll:
    cal __shift_setl
    cmp x, 31
    jms __shiftl_zero
__shll_bytes:
    cmp x, 8
    jmf __shll_bits
    mov c, d
    mov d, a
    mov a, b
    mov b, 0
    sub x, 8
    jmp __shll_bytes
__shll_bits:
    or x, 0
    jmz __shiftl_done
__shll_bit:
    shl b
    adc a, a
    adc d, d
    adc c, c
    dec x
    jmz __shiftl_done
    jmp __shll_bit
__shiftl_done:
    ret
__shiftl_zero:
    mov a, 0
    mov b, 0
    mov c, 0
    mov d, 0
    ret

__shrul:                        ; logical
    cal __shift_setl
    cmp x, 31
    jms __shiftl_zero
__shrul_bytes:
    cmp x, 8
    jmf __shrul_bits
    mov b, a
    mov a, d
    mov d, c
    mov c, 0
    sub x, 8
    jmp __shrul_bytes
__shrul_bits:
    or x, 0
    jmz __shiftl_done
__shrul_bit:
    asr c                       ; C = bit leaving c: into d, then a, then b
    and c, 0x7F
    jmc __shrul_d1
    asr d
    and d, 0x7F
    jmp __shrul_a
__shrul_d1:
    asr d
    or d, 0x80
__shrul_a:
    jmc __shrul_a1
    asr a
    and a, 0x7F
    jmp __shrul_b
__shrul_a1:
    asr a
    or a, 0x80
__shrul_b:
    jmc __shrul_b1
    asr b
    and b, 0x7F
    jmp __shrul_next
__shrul_b1:
    asr b
    or b, 0x80
__shrul_next:
    dec x
    jmz __shiftl_done
    jmp __shrul_bit

__shrl:                         ; arithmetic
    cal __shift_setl
    cmp x, 31
    jms __shrl_sign
__shrl_bytes:
    cmp x, 8
    jmf __shrl_bits
    mov b, a
    mov a, d
    mov d, c
    shl c                       ; c = 0 or -1
    mov c, 0
    sbb c, 0
    sub x, 8
    jmp __shrl_bytes
__shrl_bits:
    or x, 0
    jmz __shiftl_done
__shrl_bit:
    asr c                       ; C = bit leaving c: into d, then a, then b
    jmc __shrl_d1
    asr d
    and d, 0x7F
    jmp __shrl_a
__shrl_d1:
    asr d
    or d, 0x80
__shrl_a:
    jmc __shrl_a1
    asr a
    and a, 0x7F
    jmp __shrl_b
__shrl_a1:
    asr a
    or a, 0x80
__shrl_b:
    jmc __shrl_b1
    asr b
    and b, 0x7F
    jmp __shrl_next
__shrl_b1:
    asr b
    or b, 0x80
__shrl_next:
    dec x
    jmz __shiftl_done
    jmp __shrl_bit
__shrl_sign:
    mov a, 0
    or c, 0
    jmn __shrl_minus
    mov b, 0
    mov c, 0
    mov d, 0
    ret
__shrl_minus:
    mov a, 0xFF
    mov b, 0xFF
    mov c, 0xFF
    mov d, 0xFF
    ret
