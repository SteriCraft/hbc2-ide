; C runtime: shifts (ABI.md section 11). The count is in b (a must be 0,
; and the high bytes of a long count are ignored). A count of the size of
; the value or more gives 0, or -1 / 0 for a negative signed value.
;
; There is no rotate through carry: for a right shift, each lower byte gets
; the bit leaving the byte above it with a jump on C.

; ----- 16 bits: value in [c:d], count in [a:b], result in [a:b]

__shl:
    or a, 0
    jmz __shl_count
    mov b, 16
__shl_count:
    cmp b, 15
    jms __shift_zero
__shl_bit:
    or b, 0
    jmz __shift_done
    shl d
    adc c, c
    dec b
    jmp __shl_bit
__shift_done:
    mov a, c
    mov b, d
    ret
__shift_zero:
    mov a, 0
    mov b, 0
    ret

__shru:                         ; logical
    or a, 0
    jmz __shru_count
    mov b, 16
__shru_count:
    cmp b, 15
    jms __shift_zero
__shru_bit:
    or b, 0
    jmz __shift_done
    asr c                       ; C = bit leaving c
    and c, 0x7F                 ; and keeps C
    jmc __shru_one
    asr d
    and d, 0x7F
    dec b
    jmp __shru_bit
__shru_one:
    asr d
    or d, 0x80
    dec b
    jmp __shru_bit

__shr:                          ; arithmetic: the sign bit is copied
    or a, 0
    jmz __shr_count
    mov b, 16
__shr_count:
    cmp b, 15
    jms __shr_sign
__shr_bit:
    or b, 0
    jmz __shift_done
    asr c
    jmc __shr_one
    asr d
    and d, 0x7F
    dec b
    jmp __shr_bit
__shr_one:
    asr d
    or d, 0x80
    dec b
    jmp __shr_bit
__shr_sign:                     ; 0, or -1 for a negative value
    mov b, 0
    or c, 0
    jmn __shr_minus
    mov a, 0
    ret
__shr_minus:
    mov a, 0xFF
    mov b, 0xFF
    ret

; ----- 32 bits: value in [x:y]:[i:j], count in b, result in [c:d]:[a:b]

; [c:d]:[a:b] = value, x = count (32 when a was not 0)
__shift_setl:
    or a, 0
    jmz __shift_setl_count
    mov b, 32
__shift_setl_count:
    mov a, b
    mov c, x
    mov d, y
    mov x, a
    mov a, i
    mov b, j
    ret

__shll:
    cal __shift_setl
    cmp x, 31
    jms __shiftl_zero
__shll_bit:
    or x, 0
    jmz __shiftl_done
    shl b
    adc a, a
    adc d, d
    adc c, c
    dec x
    jmp __shll_bit
__shiftl_done:
    ret
__shiftl_zero:
    mov a, 0
    mov b, 0
    mov c, 0
    mov d, 0
    ret

__shrul:                        ; logical
    cal __shift_setl
    mov y, 1                    ; y = 1: logical loop (see __shrl_loop)
    cmp x, 31
    jms __shiftl_zero
__shrul_bit:
    or x, 0
    jmz __shiftl_done
    asr c
    and c, 0x7F
    jmp __shrl_d
__shrl_bit:                     ; arithmetic, after the count check
    or x, 0
    jmz __shiftl_done
    asr c
__shrl_d:                       ; C = bit leaving c: into d, then a, then b
    jmc __shrl_d1
    asr d
    and d, 0x7F
    jmp __shrl_a
__shrl_d1:
    asr d
    or d, 0x80
__shrl_a:
    jmc __shrl_a1
    asr a
    and a, 0x7F
    jmp __shrl_b
__shrl_a1:
    asr a
    or a, 0x80
__shrl_b:
    jmc __shrl_b1
    asr b
    and b, 0x7F
    jmp __shrl_next
__shrl_b1:
    asr b
    or b, 0x80
__shrl_next:
    dec x
    jmp __shrl_loop
__shrl_loop:                    ; the logical shift goes back to its own loop
    or y, 0
    jmz __shrl_bit
    jmp __shrul_bit

__shrl:                         ; arithmetic
    cal __shift_setl
    mov y, 0                    ; y = 0: arithmetic loop (see __shrl_loop)
    cmp x, 31
    jms __shrl_sign
    jmp __shrl_bit
__shrl_sign:
    mov a, 0
    or c, 0
    jmn __shrl_minus
    mov b, 0
    mov c, 0
    mov d, 0
    ret
__shrl_minus:
    mov a, 0xFF
    mov b, 0xFF
    mov c, 0xFF
    mov d, 0xFF
    ret
