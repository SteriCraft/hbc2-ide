; The C library: assembly part (the drivers and the wrappers of hbc2.h).
; A C program is assembled with ../runtime/crt0.has, ../runtime/runtime.has,
; this file, the compiled library files (src/*.c) and its own files.
; .library: a program may define a name of the library (puts, putchar...):
; its own definition is used, everywhere, and the library's is left out.

.library

.include "asm/mailbox.has"
.include "asm/screen.has"
.include "asm/terminal.has"
.include "asm/hbc2.has"
.include "asm/stdlib.has"
.include "asm/math.has"
.include "asm/math/math.has"
.include "asm/fmath.has"
.include "asm/stdio.has"
.include "asm/printf.has"
.include "asm/printf_float.has"
.include "asm/scanf.has"
.include "asm/string.has"
.include "asm/sort.has"
.include "asm/malloc.has"
.include "asm/time.has"
.include "asm/ctype.has"
.include "asm/errno.has"
