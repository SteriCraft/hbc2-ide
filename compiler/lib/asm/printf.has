; printf, vprintf, sprintf, vsprintf, written in assembly (they replace
; src/printf.c: 2.5 KB of compiled C). The minimal set (ROADMAP decision
; 14): %d %u %x %X %c %s %%, l for long, a width (up to 255), 0 for zero
; padding, - to align left. Unknown conversions print their character; a %
; at the end is dropped. printf and vprintf send every character through
; _putchar, so a program's own putchar is used (tests/multi/override);
; sprintf and vsprintf write them at buf, then a 0.
;
; int printf(const char *fmt, ...)
; int vprintf(const char *fmt, va_list ap)
; int sprintf(char *buf, const char *fmt, ...)
; int vsprintf(char *buf, const char *fmt, va_list ap)
;
; Each one loads fmt, ap and buf, then goes on at lib_printf_start, the
; engine they share. Where the characters go is lib_printf_out: 0 for
; _putchar, else the next byte of buf. The engine saves it in its locals
; and puts it back at the end, so a printf inside a sprintf (a program's
; putchar that calls sprintf) works.
;
; The locals (30 bytes, [sp + n] in the engine itself; 2 more in the
; lib_printf_ routines it calls, above their return address):
;   0-1   fmt: the next character of the format
;   2-3   ap: the next argument
;   4-5   count: the characters printed (the result)
;   6     width, then the number of padding characters
;   7     pad: ' ' or '0'
;   8     left: 1 for -
;   9     neg: 1 when a '-' goes before the padding or the digits
;   10    the conversion character
;   11    l: 1 for a long
;   12-13 text: what the field prints
;   14-15 len: its length
;   16-27 digits: 12 bytes (itoa32: a sign, 10 digits and the 0)
;   28-29 the lib_printf_out of the caller
; The return address is at [sp + 30].

.bss lib_printf_out 2           ; 0: _putchar, else where the next character goes

; int vprintf(const char *fmt, va_list ap)
_vprintf:
    lod x, [sp + 4]             ; ap
    lod y, [sp + 5]
    jmp lib_printf_screen

; int sprintf(char *buf, const char *fmt, ...)
_sprintf:
    rsp [x:y]                   ; ap = the first argument after fmt
    add y, 6
    adc x, 0
    jmp lib_printf_buf

; int vsprintf(char *buf, const char *fmt, va_list ap)
_vsprintf:
    lod x, [sp + 6]             ; ap
    lod y, [sp + 7]
lib_printf_buf:
    lod c, [sp + 2]             ; buf
    lod d, [sp + 3]
    lod i, [sp + 4]             ; fmt
    lod j, [sp + 5]
    jmp lib_printf_start

; int printf(const char *fmt, ...)
_printf:
    rsp [x:y]                   ; ap = the first argument after fmt
    add y, 4
    adc x, 0
lib_printf_screen:
    lod i, [sp + 2]             ; fmt
    lod j, [sp + 3]
    mov c, 0                    ; out: _putchar
    mov d, 0

; The engine: [i:j] = fmt, [x:y] = ap, [c:d] = buf (0: _putchar).
lib_printf_start:
    ssp 30
    str [sp + 0], i
    str [sp + 1], j
    str [sp + 2], x
    str [sp + 3], y
    lod a, lib_printf_out       ; the caller's out, back at the end
    str [sp + 28], a
    lod a, lib_printf_out + 1
    str [sp + 29], a
    str lib_printf_out, c
    str lib_printf_out + 1, d
    mov a, 0
    str [sp + 4], a             ; count = 0
    str [sp + 5], a

lib_printf_loop:                ; [x:y] = fmt, b = its character
    lod x, [sp + 0]
    lod y, [sp + 1]
    lod b, [x:y]
    cmp b, 0
    jme lib_printf_end
    add y, 1
    adc x, 0
    str [sp + 0], x
    str [sp + 1], y
    cmp b, '%'
    jme lib_printf_spec
lib_printf_char:                ; prints b, count + 1
    cal lib_printf_putc
    lod b, [sp + 5]
    add b, 1
    str [sp + 5], b
    lod a, [sp + 4]
    adc a, 0
    str [sp + 4], a
    jmp lib_printf_loop

lib_printf_end:
    lod x, lib_printf_out
    lod y, lib_printf_out + 1
    mov a, x
    or a, y
    jmz lib_printf_restore
    mov a, 0
    str [x:y], a                ; sprintf: the 0 after the text
lib_printf_restore:
    lod a, [sp + 28]
    str lib_printf_out, a
    lod a, [sp + 29]
    str lib_printf_out + 1, a
    lod a, [sp + 4]             ; [a:b] = count
    lod b, [sp + 5]
    asp 30
    ret

; --- A conversion: the flags, the width, l, the character ----------------
; [x:y] = fmt (after the %), c = pad, d = left

lib_printf_spec:
    mov c, ' '
    mov d, 0
lib_printf_flags:
    lod b, [x:y]
    cmp b, '0'
    jme lib_printf_zero
    cmp b, '-'
    jme lib_printf_minus
    jmp lib_printf_width
lib_printf_zero:
    mov c, '0'
    jmp lib_printf_flag_next
lib_printf_minus:
    mov d, 1
lib_printf_flag_next:
    add y, 1
    adc x, 0
    jmp lib_printf_flags

lib_printf_width:               ; a = width, b = the character
    cmp d, 0
    jme lib_printf_pad_set
    mov c, ' '                  ; - wins over 0
lib_printf_pad_set:
    str [sp + 7], c
    str [sp + 8], d
    mov a, 0
lib_printf_width_digit:
    cmp b, '0'
    jmf lib_printf_width_end    ; below '0'
    cmp b, '9'
    jms lib_printf_width_end    ; above '9'
    mov c, a                    ; width * 10 + the digit
    shl a
    shl a
    add a, c
    shl a
    sub b, '0'
    add a, b
    add y, 1
    adc x, 0
    lod b, [x:y]
    jmp lib_printf_width_digit
lib_printf_width_end:
    str [sp + 6], a
    mov a, 0
    cmp b, 'l'
    jme lib_printf_long
    jmp lib_printf_conv
lib_printf_long:
    mov a, 1
    add y, 1
    adc x, 0
    lod b, [x:y]
lib_printf_conv:
    str [sp + 11], a
    cmp b, 0
    jme lib_printf_end          ; a % at the end: stop there
    add y, 1
    adc x, 0
    str [sp + 0], x
    str [sp + 1], y
    str [sp + 10], b
    mov a, 0
    str [sp + 9], a             ; neg = 0
    cmp b, 'd'
    jme lib_printf_number
    cmp b, 'u'
    jme lib_printf_number
    cmp b, 'x'
    jme lib_printf_number
    cmp b, 'X'
    jme lib_printf_number
    cmp b, 'c'
    jme lib_printf_c
    cmp b, 's'
    jme lib_printf_s
    jmp lib_printf_char         ; %% and unknown ones: the character

; --- %c and %s: padded with spaces -----------------------------------------

lib_printf_c:
    cal lib_printf_arg16
    str [sp + 16], b            ; digits[0] = the character
    mov a, ' '
    str [sp + 7], a
    rsp [x:y]
    add y, 16
    adc x, 0
    mov c, 0
    mov d, 1
    jmp lib_printf_text_set

lib_printf_s:
    cal lib_printf_arg16
    mov x, a                    ; [x:y] = s
    mov y, b
    mov a, ' '
    str [sp + 7], a
    mov c, 0                    ; [c:d] = its length
    mov d, 0
    mov i, x
    mov j, y
lib_printf_s_len:
    lod a, [i:j]
    cmp a, 0
    jme lib_printf_text_set
    add j, 1
    adc i, 0
    add d, 1
    adc c, 0
    jmp lib_printf_s_len

; --- Numbers -----------------------------------------------------------------
; The digits go to digits ([sp + 16]); [x:y] is left on their 0. A
; negative %d gets its '-' from itoa: it is taken off and printed by the
; field, before or after the padding.

lib_printf_number:
    lod a, [sp + 11]
    cmp a, 0
    jme lib_printf_short
    lod i, [sp + 2]             ; long: [i:j] -> the argument, ap + 4
    lod j, [sp + 3]
    mov c, i
    mov d, j
    add d, 4
    adc c, 0
    str [sp + 2], c
    str [sp + 3], d
    rsp [x:y]
    add y, 16
    adc x, 0
    lod a, [sp + 10]
    cmp a, 'd'
    jme lib_printf_ld
    cmp a, 'u'
    jme lib_printf_lu
    cal htoa32
    jmp lib_printf_digits
lib_printf_ld:
    cal itoa32
    jmp lib_printf_digits
lib_printf_lu:
    cal utoa32
    jmp lib_printf_digits

lib_printf_short:
    cal lib_printf_arg16        ; [a:b] = the argument
    rsp [x:y]
    add y, 16
    adc x, 0
    lod c, [sp + 10]
    cmp c, 'd'
    jme lib_printf_d
    cmp c, 'u'
    jme lib_printf_u
    cal htoa16
    jmp lib_printf_digits
lib_printf_d:
    cal itoa16
    jmp lib_printf_digits
lib_printf_u:
    cal utoa16

lib_printf_digits:              ; [x:y] = the end, [i:j] = digits, c = length
    rsp [i:j]
    add j, 16
    adc i, 0
    mov c, y
    sub c, j
    lod a, [sp + 10]
    cmp a, 'u'
    jme lib_printf_num_text
    cmp a, 'd'
    jme lib_printf_sign_check
lib_printf_hex_zeros:           ; no leading zeros (the last one stays)
    cmp c, 1
    jme lib_printf_hex_case
    lod b, [i:j]
    cmp b, '0'
    jme lib_printf_hex_skip
    jmp lib_printf_hex_case
lib_printf_hex_skip:
    add j, 1
    adc i, 0
    dec c
    jmp lib_printf_hex_zeros
lib_printf_hex_case:
    cmp a, 'x'
    jme lib_printf_lower
    jmp lib_printf_num_text
lib_printf_lower:               ; lower case: the digits already have the bit
    mov x, i
    mov y, j
    mov d, c
lib_printf_lower_loop:
    lod b, [x:y]
    or b, 0x20
    str [x:y], b
    add y, 1
    adc x, 0
    dec d
    jmz lib_printf_num_text
    jmp lib_printf_lower_loop

lib_printf_sign_check:
    lod b, [i:j]
    cmp b, '-'
    jme lib_printf_negative
    jmp lib_printf_num_text
lib_printf_negative:
    mov b, 1
    str [sp + 9], b             ; neg = 1
    add j, 1
    adc i, 0
    dec c

lib_printf_num_text:            ; [x:y] = the text, [c:d] = its length
    mov x, i
    mov y, j
    mov d, c
    mov c, 0

; --- The field ---------------------------------------------------------------
; [x:y] = the text, [c:d] = its length. Prints the sign, the padding and
; the text; count + the larger of the width and len + neg.

lib_printf_text_set:
    str [sp + 12], x
    str [sp + 13], y
    str [sp + 14], c
    str [sp + 15], d
    add d, [sp + 9]             ; [c:d] = len + neg
    adc c, 0
    lod a, [sp + 6]             ; a = width
    cmp c, 0
    jme lib_printf_fits
    jmp lib_printf_no_pad
lib_printf_fits:
    cmp d, a
    jmf lib_printf_padded       ; shorter than the width
lib_printf_no_pad:
    mov a, 0
    str [sp + 6], a             ; no padding, count + len + neg
    jmp lib_printf_count
lib_printf_padded:               ; c = 0
    mov b, a
    sub a, d                    ; padding = width - (len + neg)
    str [sp + 6], a
    mov d, b                    ; count + width
lib_printf_count:
    lod b, [sp + 5]
    add b, d
    str [sp + 5], b
    lod b, [sp + 4]
    adc b, c
    str [sp + 4], b

    lod a, [sp + 7]
    cmp a, '0'
    jme lib_printf_zeros
    lod a, [sp + 8]
    cmp a, 0
    jme lib_printf_right
    cal lib_printf_sign         ; left: -42 then the spaces
    cal lib_printf_text
    cal lib_printf_pad
    jmp lib_printf_loop
lib_printf_right:               ; right: the spaces then -42
    cal lib_printf_pad
    cal lib_printf_sign
    cal lib_printf_text
    jmp lib_printf_loop
lib_printf_zeros:               ; -0042: the sign before the zeros
    cal lib_printf_sign
    cal lib_printf_pad
    cal lib_printf_text
    jmp lib_printf_loop

; --- Routines called by printf (its locals are 2 bytes further) -----------

; Prints b, or stores it at lib_printf_out (every register may change).
lib_printf_putc:
    lod x, lib_printf_out
    lod y, lib_printf_out + 1
    mov a, x
    or a, y
    jmz lib_printf_putchar
    str [x:y], b                ; sprintf: one more character in buf
    add y, 1
    adc x, 0
    str lib_printf_out, x
    str lib_printf_out + 1, y
    ret
lib_printf_putchar:
    mov a, 0
    psh b, a                    ; putchar(b)
    cal _putchar
    asp 2
    ret

; [a:b] = the next 16-bit argument, ap + 2. Changes x, y.
lib_printf_arg16:
    lod x, [sp + 4]
    lod y, [sp + 5]
    lod a, [x:y]
    lod b, [x:y + 1]
    add y, 2
    adc x, 0
    str [sp + 4], x
    str [sp + 5], y
    ret

; Prints '-' when neg.
lib_printf_sign:
    lod a, [sp + 11]
    cmp a, 0
    jme lib_printf_sign_end
    mov b, '-'
    jmp lib_printf_putc
lib_printf_sign_end:
    ret

; Prints pad, as many times as [sp + 6] says (which ends at 0).
lib_printf_pad:
    lod a, [sp + 8]
    cmp a, 0
    jme lib_printf_pad_end
    dec a
    str [sp + 8], a
    lod b, [sp + 9]
    cal lib_printf_putc
    jmp lib_printf_pad
lib_printf_pad_end:
    ret

; Prints the text: len characters from text.
lib_printf_text:
    lod c, [sp + 16]
    lod d, [sp + 17]
    sub d, 1
    sbb c, 0
    jmc lib_printf_text_end     ; len was 0
    str [sp + 16], c
    str [sp + 17], d
    lod x, [sp + 14]
    lod y, [sp + 15]
    lod b, [x:y]
    add y, 1
    adc x, 0
    str [sp + 14], x
    str [sp + 15], y
    cal lib_printf_putc
    jmp lib_printf_text
lib_printf_text_end:
    ret
