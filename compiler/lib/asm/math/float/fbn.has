; ============================================================
; Bignums for the text conversions (ftext.has)
; ============================================================
; A bignum is 32 bytes (256 bits), little endian (byte 0 = least
; significant), inside the frame that i:j points to. The routines take the
; offsets in the frame in a (and b): "a" is the number that changes, "b"
; the second one. They keep every register and i:j; a is destroyed, and so
; are the CPU flags (except bn_cmp: S E F).
;
;   bn_zero   [a] = 0
;   bn_copy   [a] = [b]
;   bn_add    [a] += [b]           bn_sub   [a] -= [b]
;   bn_cmp    compares [a] with [b]: F less, E equal, S greater
;   bn_shl1   [a] <<= 1            bn_shl   [a] <<= b (0..255)
;   bn_mul5   [a] *= 5             bn_mul10 [a] *= 10  (use TA_T as a work area)
;   bn_bitlen a = the number of bits of [a] (0 for 0)
; The add and the sub work 8 bytes at a time with the pointers moved between
; the groups (the carry is saved with psf/pof).

.define TA_R   0
.define TA_S   32
.define TA_M   64
.define TA_P   96
.define TA_T   128

; c:d = i:j + a, x:y = i:j + b
bn_ptrs:
    mov c, i
    mov d, j
    add d, a
    adc c, 0
    mov x, i
    mov y, j
    add y, b
    adc x, 0
    ret

bn_add:
    psh b, c, d, x, y
    cal bn_ptrs
    mov b, 4
    clc
bna_l:
    lod a, [c:d]
    adc a, [x:y]
    str [c:d], a
    lod a, [c:d + 1]
    adc a, [x:y + 1]
    str [c:d + 1], a
    lod a, [c:d + 2]
    adc a, [x:y + 2]
    str [c:d + 2], a
    lod a, [c:d + 3]
    adc a, [x:y + 3]
    str [c:d + 3], a
    lod a, [c:d + 4]
    adc a, [x:y + 4]
    str [c:d + 4], a
    lod a, [c:d + 5]
    adc a, [x:y + 5]
    str [c:d + 5], a
    lod a, [c:d + 6]
    adc a, [x:y + 6]
    str [c:d + 6], a
    lod a, [c:d + 7]
    adc a, [x:y + 7]
    str [c:d + 7], a
    psf
    add d, 8
    adc c, 0
    add y, 8
    adc x, 0
    dec b
    jmz bna_end
    pof
    jmp bna_l
bna_end:
    pof
    pop b, c, d, x, y
    ret

bn_sub:
    psh b, c, d, x, y
    cal bn_ptrs
    mov b, 4
    clc
bnsb_l:
    lod a, [c:d]
    sbb a, [x:y]
    str [c:d], a
    lod a, [c:d + 1]
    sbb a, [x:y + 1]
    str [c:d + 1], a
    lod a, [c:d + 2]
    sbb a, [x:y + 2]
    str [c:d + 2], a
    lod a, [c:d + 3]
    sbb a, [x:y + 3]
    str [c:d + 3], a
    lod a, [c:d + 4]
    sbb a, [x:y + 4]
    str [c:d + 4], a
    lod a, [c:d + 5]
    sbb a, [x:y + 5]
    str [c:d + 5], a
    lod a, [c:d + 6]
    sbb a, [x:y + 6]
    str [c:d + 6], a
    lod a, [c:d + 7]
    sbb a, [x:y + 7]
    str [c:d + 7], a
    psf
    add d, 8
    adc c, 0
    add y, 8
    adc x, 0
    dec b
    jmz bnsb_end
    pof
    jmp bnsb_l
bnsb_end:
    pof
    pop b, c, d, x, y
    ret

bn_shl1:
    psh b, c, d, x, y
    cal bn_ptrs
    mov b, 4
    clc
bnh_l:
    lod a, [c:d]
    adc a, a
    str [c:d], a
    lod a, [c:d + 1]
    adc a, a
    str [c:d + 1], a
    lod a, [c:d + 2]
    adc a, a
    str [c:d + 2], a
    lod a, [c:d + 3]
    adc a, a
    str [c:d + 3], a
    lod a, [c:d + 4]
    adc a, a
    str [c:d + 4], a
    lod a, [c:d + 5]
    adc a, a
    str [c:d + 5], a
    lod a, [c:d + 6]
    adc a, a
    str [c:d + 6], a
    lod a, [c:d + 7]
    adc a, a
    str [c:d + 7], a
    psf
    add d, 8
    adc c, 0
    dec b
    jmz bnh_end
    pof
    jmp bnh_l
bnh_end:
    pof
    pop b, c, d, x, y
    ret

bn_copy:
    psh b, c, d, x, y
    cal bn_ptrs
    mov b, 4
bnp_l:
    lod a, [x:y]
    str [c:d], a
    lod a, [x:y + 1]
    str [c:d + 1], a
    lod a, [x:y + 2]
    str [c:d + 2], a
    lod a, [x:y + 3]
    str [c:d + 3], a
    lod a, [x:y + 4]
    str [c:d + 4], a
    lod a, [x:y + 5]
    str [c:d + 5], a
    lod a, [x:y + 6]
    str [c:d + 6], a
    lod a, [x:y + 7]
    str [c:d + 7], a
    add d, 8
    adc c, 0
    add y, 8
    adc x, 0
    dec b
    jmz bnp_end
    jmp bnp_l
bnp_end:
    pop b, c, d, x, y
    ret

bn_zero:
    psh b, c, d, x, y
    cal bn_ptrs
    mov b, 4
    mov a, 0
bnz_l:
    str [c:d], a
    str [c:d + 1], a
    str [c:d + 2], a
    str [c:d + 3], a
    str [c:d + 4], a
    str [c:d + 5], a
    str [c:d + 6], a
    str [c:d + 7], a
    add d, 8
    adc c, 0
    dec b
    jmz bnz_end
    jmp bnz_l
bnz_end:
    pop b, c, d, x, y
    ret

; From the top byte down: the first byte that differs decides (flags of cmp).
bn_cmp:
    psh b, c, d, x, y
    cal bn_ptrs
    add d, 31
    adc c, 0
    add y, 31
    adc x, 0
    mov b, 32
bnc_l:
    lod a, [c:d]
    cmp a, [x:y]
    jme bnc_next
    pop b, c, d, x, y           ; (pop leaves the flags alone)
    ret
bnc_next:
    sub d, 1
    sbb c, 0
    sub y, 1
    sbb x, 0
    dec b
    jmz bnc_eq
    jmp bnc_l
bnc_eq:
    cmp a, a                    ; E
    pop b, c, d, x, y
    ret

bn_bitlen:
    psh b, c, d, x, y
    cal bn_ptrs
    add d, 31
    adc c, 0
    mov b, 32
bnb_l:
    lod a, [c:d]
    or a, 0
    jmz bnb_next
    mov x, 0                    ; x = bits in this byte
bnb_bits:
    inc x
    shr a
    or a, 0
    jmz bnb_found
    jmp bnb_bits
bnb_found:
    dec b                       ; (b - 1) * 8 + x
    shl b
    shl b
    shl b
    add b, x
    mov a, b
    pop b, c, d, x, y
    ret
bnb_next:
    sub d, 1
    sbb c, 0
    dec b
    jmz bnb_zero
    jmp bnb_l
bnb_zero:
    mov a, 0
    pop b, c, d, x, y
    ret

; [a] <<= b. The bits first (b & 7 times bn_shl1), then the bytes (b >> 3).
bn_shl:
    psh b, c, d, x, y
    mov c, a                    ; c = offset
    mov d, b
    and d, 7
bnl_b:
    cmp d, 0
    jme bnl_bytes
    mov a, c
    cal bn_shl1
    dec d
    jmp bnl_b
bnl_bytes:
    mov a, b
    shr a
    shr a
    shr a                       ; a = q, the bytes to move
    cmp a, 0
    jme bnl_ret
    mov b, a
    mov a, c
    psh b
    cal bn_ptrs                 ; c:d = the number
    pop b
    psh i, j
    mov j, b                    ; j = q
    add d, 31
    adc c, 0                    ; c:d = top byte (destination)
    mov x, c
    mov y, d
    sub y, j
    sbb x, 0                    ; x:y = top byte - q (source)
    mov a, 32
    sub a, j                    ; a = bytes to move
bnl_mv:
    lod i, [x:y]
    str [c:d], i
    sub d, 1
    sbb c, 0
    sub y, 1
    sbb x, 0
    dec a
    jmz bnl_mvd
    jmp bnl_mv
bnl_mvd:
    mov i, 0                    ; the q low bytes: 0
bnl_z:
    str [c:d], i
    sub d, 1
    sbb c, 0
    dec j
    jmz bnl_zd
    jmp bnl_z
bnl_zd:
    pop i, j
bnl_ret:
    pop b, c, d, x, y
    ret

bn_mul5:
    psh b, c
    mov c, a
    mov b, a
    mov a, TA_T
    cal bn_copy
    mov a, c
    cal bn_shl1
    mov a, c
    cal bn_shl1
    mov a, c
    mov b, TA_T
    cal bn_add
    pop b, c
    ret

bn_mul10:
    psh a
    cal bn_mul5
    pop a
    jmp bn_shl1
