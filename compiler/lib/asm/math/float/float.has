; ============================================================
; float.has - binary32 (IEEE 754 single precision) library
;
; A float is 4 bytes in memory, big-endian (like every 32-bit value of
; the math library):
;
;     byte 0     byte 1     byte 2     byte 3
;     S EEEEEEE  E FFFFFFF  FFFFFFFF   FFFFFFFF
;
;     S = sign, E = exponent (8 bits, bias 127), F = fraction (23 bits)
;
; Conventions
;   * Same as the 32-bit integer routines: [x:y] = 1st float (and the
;     destination), [i:j] = 2nd float. Offsets [x:y + n] are used inside.
;   * Routines restore every register except their outputs.
;   * Everything IEEE 754: rounding to nearest even, subnormals, infinities,
;     signed zeros, NaN. A NaN made by a routine is always the quiet NaN
;     0x7FC00000; the payload of a NaN operand is not propagated.
;   * Exceptions (invalid, divide by zero, overflow, underflow, inexact) are
;     not traps: a routine raises the flags of fenv.has (sticky, until the
;     program clears them) and goes on with the IEEE default result.
;   * Flags: only listed where a routine promises them. Not listed =
;     undefined.
;   * `double` is the same type as `float` (the compiler maps it).
;
; Files
;   fenv.has   exception flags (feclearexcept, fetestexcept...)
;   fbits.has  fabs, fneg, copysign, signbit, classification, NaN
;   fcmp.has   fcmp, fcmps, feq... fisunordered, fmin, fmax
;   fadd.has   fadd, fsub, fdim (and the unpack helpers shared by fmul, fdiv)
;   fmul.has   fmul
;   fdiv.has   fdiv
;   fconv.has  itof, utof, ftoi, ftou
;   fround.has ftrunc, ffloor, fceil, fround, frint, fnearbyint
;   fscale.has frexp, ldexp
;   fmod.has   fmod
;   fsqrt.has  fsqrt
;   fbn.has    bignums (work area of ftext.has)
;   ftext.has  ftoa
;   fatof.has  atof
;   fexp.has   exp, exp2, exp10 (and the frame start-up of flog, fpow)
;   flog.has   log, log2, log10
;   fpow.has   pow
;   ftrig.has  sin, cos, tan (and the Payne-Hanek reduction)
;   fatan.has  atan, atan2, asin, acos
;   fhyp.has   expm1, log1p, sinh, cosh, tanh (fhyp2.has: hypot, cbrt;
;              fhyp3.has: asinh, acosh, atanh)
;   fx.has     slot helpers of the functions from fexp.has on; fmathk.has: their
;              constants and tables (generated by tools/ftest, genk)
; ============================================================

.include "fenv.has"
.include "fbits.has"
.include "fcmp.has"
.include "fadd.has"
.include "fmul.has"
.include "fdiv.has"
.include "fconv.has"
.include "fround.has"
.include "fscale.has"
.include "fmod.has"
.include "fsqrt.has"
.include "fbn.has"
.include "ftext.has"
.include "fatof.has"
.include "fmathk.has"
.include "fx.has"
.include "fexp.has"
.include "flog.has"
.include "fpow.has"
.include "ftrig.has"
.include "fatan.has"
.include "fhyp.has"
.include "fhyp2.has"
.include "fhyp3.has"
