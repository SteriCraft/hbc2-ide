    mov b, K_M1_5
    cal fx_addc
    mov b, V6
    cal fx_mul
    mov b, K_1_3
    cal fx_addc
    mov a, V8                   ; uh^3 S
    mov b, V4
    cal fx_cpy
    mov b, V6
    cal fx_mul
    mov b, V7
    cal fx_mul
    mov a, V12                  ; w = (ul - uh^3 S) + atan c low
    mov b, V5
    cal fx_cpy
    mov b, V8
    cal fx_sub
    mov b, V11
    cal fx_add
    mov a, V13                  ; s = atan c high + uh
    mov b, V10
    cal fx_cpy
    mov b, V4
    cal fx_add
    mov a, V14                  ; e = (atan c high - s) + uh
    mov b, V10
