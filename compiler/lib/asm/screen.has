; ============================================================
; screen.has - the native display
; ============================================================
;
; Text and graphics through the I/O processor's native commands
; (Documentation/Peripherals/Native/Reference.md): one picture of
; 256 x 192 pixels, 16 colours, text in 8 x 8 cells (32 columns x 24
; rows, Windows-1252 characters), a cursor kept by the I/O processor.
;
; Copy for the C library: the display's port is _display_port
; (compiler/runtime/devices.has), 0 when there is no native display.
; Every routine sets C = 1 and sends nothing without one.
;
; Interrupts: each routine saves the caller's flags (psf) and restores
; them at the end (pof). In between, interrupts are off for ONE command
; at a time (a read: the command and its reply), then allowed again if
; the caller allowed them (scr_open). The longest window with interrupts
; off is one PUTS of 255 characters (about 13,500 cycles, 6.8 ms).
; Commands go straight to the mailbox: c = STATUS, d = DATA while sending.
; Every register is restored, except outputs. Flags are changed.
; A handler must not draw: its commands would land between two of the
; interrupted call's, with the I/O processor's cursor and colours moved.
;
; screen_colors holds the text colours of the terminal (bg << 4 | fg):
; the routines that draw text in other colours set them back afterwards.

.define SCREEN_COLUMNS 32
.define SCREEN_ROWS 24
.define SCREEN_HEIGHT 192
.define SCREEN_DEFAULT_COLORS 0x1E  ; bright yellow on blue
.define SCR_FLAG_I 0x04         ; the Interrupt flag in the byte psf pushes

.define NAT_PUTC 0x10           ; native commands
.define NAT_PUTS 0x11
.define NAT_CURSOR 0x12
.define NAT_COLOR 0x13
.define NAT_CLEAR 0x14
.define NAT_SCROLL 0x15
.define NAT_DEFCHAR 0x16
.define NAT_GET_CHAR 0x17
.define NAT_GET_CURSOR 0x18
.define NAT_SHOW_CURSOR 0x19
.define NAT_TEXT_RESET 0x1F
.define NAT_PIXEL 0x30
.define NAT_LINE 0x31
.define NAT_RECT 0x32
.define NAT_FILL_RECT 0x33
.define NAT_GET_PIXEL 0x34
.define NAT_GET_TIME 0x60
.define NAT_VSYNC 0x61

.data screen_colors 0x1E        ; the terminal's text colours
.data scr_count 0               ; bytes left in the PUTS being sent
.data scr_iflag 0               ; the flags of the routine's caller (scr_mark)


; ------------------------------------------------------------
; Sending
; ------------------------------------------------------------

; C = 1 when there is no native display. Changes the flags only.
scr_check:
    psh a
    lod a, _display_port
    cmp a, 0
    pop a
    jme scr_check_none
    clc
    ret
scr_check_none:
    stc
    ret

; Called right after the routine's psf: keeps the caller's flags for
; scr_open. Keeps every register.
scr_mark:
    psh a
    lod a, [sp + 3]             ; the byte psf pushed (above the return address)
    str scr_iflag, a
    pop a
    ret

; After a command (and its reply): interrupts on again if the caller had
; them on. Keeps every register; changes the flags.
scr_open:
    psh a
    lod a, scr_iflag
    and a, SCR_FLAG_I
    pop a
    jmz scr_open_end
    sti                         ; (from after the next instruction)
scr_open_end:
    ret

; Sends b once TX is free (c = STATUS, d = DATA). Changes a.
scr_byte:
    in a, c
    and a, MBX_TX_FREE
    jmz scr_byte
    out d, b
    ret

; b = the next reply byte (c = STATUS, d = DATA). Changes a.
scr_recv:
    in a, c
    and a, MBX_RX_AVAIL
    jmz scr_recv
    in b, d
    ret

; COLOR for the colours in x (bg << 4 | fg): one command. Changes a, b.
scr_color:
    cli
    mov b, NAT_COLOR
    cal scr_byte
    mov b, x
    and b, 0x0F
    cal scr_byte
    mov b, x
    shr b
    shr b
    shr b
    shr b
    cal scr_byte
    cal scr_open
    ret

; COLOR screen_colors. Changes a, b, x.
scr_color_back:
    lod x, screen_colors
    cal scr_color
    ret

; CURSOR x y: one command. Changes a, b.
scr_cursor:
    cli
    mov b, NAT_CURSOR
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    cal scr_open
    ret

; Sends the [x:y] bytes at [i:j] as PUTS commands of 255 bytes at most,
; one command at a time. [i:j] advances past the text. Changes a, b, x, y.
scr_stream:
    mov a, x
    or a, y
    jmz scr_stream_end          ; nothing (left)
    mov b, 255                  ; b = this command's length
    cmp x, 0
    jme scr_stream_short
    jmp scr_stream_go           ; 256 or more left: 255
scr_stream_short:
    cmp y, 255
    jme scr_stream_go
    mov b, y                    ; less than 255 left: all of them
scr_stream_go:
    sub y, b                    ; [x:y] -= b
    sbb x, 0
    str scr_count, b
    cli
    psh b
    mov b, NAT_PUTS
    cal scr_byte
    pop b
    cal scr_byte                ; n
scr_stream_next:
    lod b, [i:j]
scr_stream_wait:
    in a, c
    and a, MBX_TX_FREE
    jmz scr_stream_wait
    out d, b
    add j, 1
    adc i, 0
    dec scr_count
    jmz scr_stream_done
    jmp scr_stream_next
scr_stream_done:
    cal scr_open                ; between two PUTS
    jmp scr_stream
scr_stream_end:
    ret


; ------------------------------------------------------------
; Text
; ------------------------------------------------------------

; screen_putc: character a (0x20-0xFF) in cell x, y (0-31, 0-23), colours
; b; the cursor ends after it. C = 1: a < 0x20, off the grid, no display.
screen_putc:
    cal scr_check
    jmc screen_putc_err
    cmp a, 0x20
    jmf screen_putc_err
    cmp x, SCREEN_COLUMNS
    jmf screen_putc_x
    jmp screen_putc_err
screen_putc_x:
    cmp y, SCREEN_ROWS
    jmf screen_putc_ok
screen_putc_err:
    stc
    ret
screen_putc_ok:
    psf
    cal scr_mark
    psh a, b, c, d, x
    mov c, MBX_STATUS
    mov d, MBX_DATA
    cal scr_cursor
    lod x, [sp + 3]             ; x = b, the colours
    cal scr_color
    cli
    mov b, NAT_PUTC
    cal scr_byte
    lod b, [sp + 4]             ; a, the character
    cal scr_byte
    cal scr_open
    cal scr_color_back
    pop a, b, c, d, x
    pof
    clc
    ret

; screen_getc: the cell x, y -> a = character, b = colours.
; C = 1 off the grid or without a display.
screen_getc:
    cal scr_check
    jmc screen_getc_err
    cmp x, SCREEN_COLUMNS
    jmf screen_getc_x
    jmp screen_getc_err
screen_getc_x:
    cmp y, SCREEN_ROWS
    jmf screen_getc_ok
screen_getc_err:
    stc
    ret
screen_getc_ok:
    psf
    cli                         ; one command and its reply
    psh c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_GET_CHAR
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    cal scr_recv
    psh b                       ; the character
    cal scr_recv                ; b = colours
    pop a
    pop c, d
    pof
    clc
    ret

; screen_write: the [c:d] characters at [i:j] from cell x, y, in colours
; b, as PUTS draws them (control codes, wrap, scroll). C = 1: off the
; grid, or no display.
screen_write:
    cal scr_check
    jmc screen_write_err
    cmp x, SCREEN_COLUMNS
    jmf screen_write_x
    jmp screen_write_err
screen_write_x:
    cmp y, SCREEN_ROWS
    jmf screen_write_ok
screen_write_err:
    stc
    ret
screen_write_ok:
    psf
    cal scr_mark
    psh a, b, c, d, i, j, x, y
    mov a, c                    ; [x:y] = the length (after the cursor)
    mov b, d
    psh a, b
    mov c, MBX_STATUS
    mov d, MBX_DATA
    cal scr_cursor
    lod x, [sp + 8]             ; the colours (b)
    cal scr_color
    pop x, y
    cal scr_stream
    cal scr_color_back
    pop a, b, c, d, i, j, x, y
    pof
    clc
    ret

; screen_puts: the 0-terminated text at [i:j], at the cursor, in
; screen_colors. [i:j] ADVANCES to the 0. C = 1: no display (nothing
; sent, [i:j] still advances).
screen_puts:
    psh a, x, y
    mov x, 0                    ; [x:y] = the length
    mov y, 0
    psh i, j
screen_puts_len:
    lod a, [i:j]
    cmp a, 0
    jme screen_puts_counted
    add j, 1
    adc i, 0
    add y, 1
    adc x, 0
    jmp screen_puts_len
screen_puts_counted:
    pop i, j
    cal scr_check
    jmc screen_puts_none
    psf
    cal scr_mark
    psh b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    cal scr_stream
    pop b, c, d
    pof
    pop a, x, y
    clc
    ret
screen_puts_none:
    add j, y                    ; skip the text anyway
    adc i, x
    pop a, x, y
    stc
    ret

; screen_out: PUTC a at the cursor (a character or a control code).
; C = 1: no display.
screen_out:
    cal scr_check
    jmc screen_out_end
    psf
    cli
    psh a, b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_PUTC
    cal scr_byte
    lod b, [sp + 3]             ; a
    cal scr_byte
    pop a, b, c, d
    pof
    clc
screen_out_end:
    ret

; screen_clear: the screen in colours b (spaces), cursor at 0, 0.
; C = 1: no display.
screen_clear:
    cal scr_check
    jmc screen_clear_end
    psf
    cal scr_mark
    psh a, b, c, d, x
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov x, b
    cal scr_color               ; the spaces' colours
    cli
    mov b, NAT_CLEAR
    cal scr_byte
    mov b, x
    shr b
    shr b
    shr b
    shr b
    cal scr_byte                ; the background
    cal scr_open
    cal scr_color_back
    pop a, b, c, d, x
    pof
    clc
screen_clear_end:
    ret

; screen_set_colors: the text colours for what comes next = b (bg << 4 |
; fg), kept in screen_colors. C = 1: no display (screen_colors is set).
screen_set_colors:
    str screen_colors, b
    cal scr_check
    jmc screen_set_colors_end
    psf
    cal scr_mark
    psh a, b, c, d, x
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov x, b
    cal scr_color
    pop a, b, c, d, x
    pof
    clc
screen_set_colors_end:
    ret

; screen_set_bg / screen_set_txt: a = new background / character colour
; (0-15) of every cell, characters kept. The cursor goes back where it
; was (a pending wrap is lost). Each cell is read and drawn again: 4
; commands, interrupts allowed between them. C = 1: a > 15 or no display.
screen_set_bg:
    psh b
    mov b, 0x0F                 ; keep the character colour
    jmp scr_recolor
screen_set_txt:
    psh b
    mov b, 0xF0                 ; keep the background
    jmp scr_recolor
; b = the bits of the old colours to keep, a = the new colour.
scr_recolor:
    cmp a, 16
    jmf scr_recolor_ok
scr_recolor_err:
    pop b
    stc
    ret
scr_recolor_ok:
    cal scr_check
    jmc scr_recolor_err
    psf
    cal scr_mark
    psh a, c, d, i, j, x, y
    cmp b, 0x0F
    jme scr_recolor_bg
    jmp scr_recolor_go          ; text colour: a stays in the low nibble
scr_recolor_bg:
    shl a                       ; background: in the high nibble
    shl a
    shl a
    shl a
scr_recolor_go:
    mov i, a                    ; i = the new colour, in place
    mov j, b                    ; j = the bits kept
    mov c, MBX_STATUS
    mov d, MBX_DATA
    cli
    mov b, NAT_GET_CURSOR
    cal scr_byte
    cal scr_recv
    mov x, b
    cal scr_recv
    mov y, b
    cal scr_open
    psh x, y                    ; the cursor, to put back
    mov y, 0
scr_recolor_row:
    mov x, 0
scr_recolor_cell:
    cli
    mov b, NAT_GET_CHAR
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    cal scr_recv
    psh b                       ; the character
    cal scr_recv                ; b = its colours
    cal scr_open
    and b, j
    or b, i                     ; b = the new colours
    psh b
    cal scr_cursor
    pop b
    psh x
    mov x, b
    cal scr_color
    pop x
    pop b
    cmp b, 0x20
    jmf scr_recolor_control
    jmp scr_recolor_putc
scr_recolor_control:
    mov b, ' '                  ; a control code (old ports): drawn blank
scr_recolor_putc:
    psh b
    cli
    mov b, NAT_PUTC
    cal scr_byte
    pop b
    cal scr_byte                ; the character again, in the new colours
    cal scr_open
    inc x
    cmp x, SCREEN_COLUMNS
    jmf scr_recolor_cell
    inc y
    cmp y, SCREEN_ROWS
    jmf scr_recolor_row
    pop x, y
    cmp x, SCREEN_COLUMNS
    jmf scr_recolor_cursor
    mov x, 31                   ; a pending wrap: back on the last column
scr_recolor_cursor:
    cal scr_cursor
    cal scr_color_back
    pop a, c, d, i, j, x, y
    pof
    pop b
    clc
    ret

; screen_scroll: the screen moves up a rows. C = 1: no display.
screen_scroll:
    psh b
    mov b, NAT_SCROLL
    jmp scr_cmd_a

; screen_show_cursor: a = 1 shows the blinking cursor, 0 hides it.
; C = 1: no display.
screen_show_cursor:
    psh b
    mov b, NAT_SHOW_CURSOR
    jmp scr_cmd_a

; screen_vsync: a = 1 sends the VSYNC event every frame, 0 stops it.
; C = 1: no display.
screen_vsync:
    psh b
    mov b, NAT_VSYNC
    jmp scr_cmd_a

; Sends command b (pushed by the caller) with the argument a.
scr_cmd_a:
    cal scr_check
    jmc scr_cmd_a_end
    psf
    cli
    psh a, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    cal scr_byte
    lod b, [sp + 2]             ; a
    cal scr_byte
    pop a, c, d
    pof
    clc
scr_cmd_a_end:
    pop b
    ret

; screen_cursor: the cursor to cell x, y. C = 1: off the grid, no display.
screen_cursor:
    cal scr_check
    jmc screen_cursor_end
    cmp x, SCREEN_COLUMNS
    jmf screen_cursor_x
    jmp screen_cursor_err
screen_cursor_x:
    cmp y, SCREEN_ROWS
    jmf screen_cursor_ok
screen_cursor_err:
    stc
    ret
screen_cursor_ok:
    psf
    cli
    psh a, b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_CURSOR
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    pop a, b, c, d
    pof
    clc
screen_cursor_end:
    ret

; screen_get_cursor: x = column (32 with a pending wrap), y = row.
; C = 1: no display.
screen_get_cursor:
    cal scr_check
    jmc screen_get_cursor_end
    psf
    cli
    psh a, b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_GET_CURSOR
    cal scr_byte
    cal scr_recv
    mov x, b
    cal scr_recv
    mov y, b
    pop a, b, c, d
    pof
    clc
screen_get_cursor_end:
    ret

; screen_defchar: the glyph of code a (0x20-0xFF) = the 8 bytes at [i:j]
; (top row first, bit 7 = left). C = 1: a < 0x20, no display.
screen_defchar:
    cmp a, 0x20
    jmf screen_defchar_err
    cal scr_check
    jmc screen_defchar_end
    psf
    cli
    psh a, b, c, d, x
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_DEFCHAR
    cal scr_byte
    lod b, [sp + 4]             ; a
    cal scr_byte
    psh i, j
    mov x, 8
screen_defchar_row:
    lod b, [i:j]
    cal scr_byte
    add j, 1
    adc i, 0
    dec x
    jmz screen_defchar_done
    jmp screen_defchar_row
screen_defchar_done:
    pop i, j
    pop a, b, c, d, x
    pof
    clc
screen_defchar_end:
    ret
screen_defchar_err:
    stc
    ret

; screen_reset: TEXT_RESET (default font, colours, cursor; the screen
; cleared in blue), screen_colors back to its default. C = 1: no display.
screen_reset:
    cal scr_check
    jmc screen_reset_end
    psf
    cli
    psh a, b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_TEXT_RESET
    cal scr_byte
    mov a, SCREEN_DEFAULT_COLORS
    str screen_colors, a
    pop a, b, c, d
    pof
    clc
screen_reset_end:
    ret


; ------------------------------------------------------------
; Graphics (each routine sends one command)
; ------------------------------------------------------------

; screen_put_pixel: pixel x, y in colour b. C = 1: b > 15, y > 191, no
; display.
screen_put_pixel:
    cmp y, SCREEN_HEIGHT
    jmf screen_put_pixel_y
    stc
    ret
screen_put_pixel_y:
    psh a
    mov a, NAT_PIXEL
    jmp scr_xy_b

; Sends command a (pushed a saved by the caller) with x, y, b, after
; checking b < 16 and the display.
scr_xy_b:
    cmp b, 16
    jmf scr_xy_b_color
    pop a
    stc
    ret
scr_xy_b_color:
    cal scr_check
    jmc scr_xy_b_none
    psf
    cli
    psh b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, a
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    lod b, [sp + 2]             ; the colour
    cal scr_byte
    pop b, c, d
    pof
    pop a
    clc
    ret
scr_xy_b_none:
    pop a
    stc
    ret

; screen_get_pixel: b = the colour of pixel x, y. C = 1: y > 191, no
; display.
screen_get_pixel:
    cmp y, SCREEN_HEIGHT
    jmf screen_get_pixel_y
    stc
    ret
screen_get_pixel_y:
    cal scr_check
    jmc screen_get_pixel_end
    psf
    cli
    psh a, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, NAT_GET_PIXEL
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    cal scr_recv
    pop a, c, d
    pof
    clc
screen_get_pixel_end:
    ret

; screen_fill: the whole picture in colour b (FILL_RECT 0, 0, 256, 256:
; the text cells and the cursor don't change). C = 1: b > 15, no display.
screen_fill:
    psh i, j, x, y
    mov x, 0
    mov y, 0
    mov i, 0                    ; 0 = 256
    mov j, 0
    cal screen_fill_rect
    pop i, j, x, y
    ret

; screen_line: from x, y to i, j in colour b (both ends drawn, clipped).
; screen_rect / screen_fill_rect: i x j pixels from x, y (outline / filled;
; a size of 0 means 256). C = 1: b > 15, no display.
screen_line:
    psh a
    mov a, NAT_LINE
    jmp scr_xyij_b
screen_rect:
    psh a
    mov a, NAT_RECT
    jmp scr_xyij_b
screen_fill_rect:
    psh a
    mov a, NAT_FILL_RECT
    jmp scr_xyij_b

; Sends command a (pushed a saved by the caller) with x, y, i, j, b.
scr_xyij_b:
    cmp b, 16
    jmf scr_xyij_b_color
    pop a
    stc
    ret
scr_xyij_b_color:
    cal scr_check
    jmc scr_xy_b_none
    psf
    cli
    psh b, c, d
    mov c, MBX_STATUS
    mov d, MBX_DATA
    mov b, a
    cal scr_byte
    mov b, x
    cal scr_byte
    mov b, y
    cal scr_byte
    mov b, i
    cal scr_byte
    mov b, j
    cal scr_byte
    lod b, [sp + 2]             ; the colour
    cal scr_byte
    pop b, c, d
    pof
    pop a
    clc
    ret
