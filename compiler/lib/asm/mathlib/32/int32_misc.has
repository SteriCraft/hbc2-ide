; ------------------------------------------------------------
; neg32: 32-bit value at [x:y] = -value (two's complement)
; flags: C = overflow (the input was -2147483648, which stays the same),
;        Z = result is 0
; ------------------------------------------------------------
; 0 - value, byte by byte from the LSB: the ALU reads the value from
; memory, and mov / str / or leave C alone between the bytes.
neg32:
    psh a, b
    mov a, 0                ; byte 3 (LSB)
    sub a, [x:y + 3]
    str [x:y + 3], a
    mov b, a                ; b = OR of the result bytes
    mov a, 0                ; byte 2
    sbb a, [x:y + 2]
    str [x:y + 2], a
    or b, a
    mov a, 0                ; byte 1
    sbb a, [x:y + 1]
    str [x:y + 1], a
    or b, a
    mov a, 0                ; byte 0 (MSB)
    sbb a, [x:y]
    str [x:y], a
    or b, a                 ; Z = result is 0
    clc                     ; overflow only for 0x80000000: clc and cmp
    cmp a, 0x80             ; leave Z alone
    jme neg32_msb
    pop a, b
    ret
neg32_msb:
    cmp b, 0x80             ; MSB = 0x80: the other bytes must be 0
    jme neg32_ovf
    pop a, b
    ret
neg32_ovf:
    stc
    pop a, b
    ret

; ------------------------------------------------------------
; abs32: 32-bit value at [x:y] = |value| (the value is signed)
; flags: C = overflow (the input was -2147483648, which stays 0x80000000),
;        Z = result is 0
; ------------------------------------------------------------
abs32:
    psh a
    lod a, [x:y]
    or a, 0                 ; N = sign bit
    jmn abs32_neg
    or a, [x:y + 1]
    or a, [x:y + 2]
    or a, [x:y + 3]         ; Z
    clc
    pop a
    ret
abs32_neg:
    pop a
    jmp neg32               ; negative: neg32 returns to our caller

; ------------------------------------------------------------
; min32s: value at [x:y] = the smaller of the values at [x:y] and [i:j]
; max32s: value at [x:y] = the larger of the values at [x:y] and [i:j]
; (signed)
; ------------------------------------------------------------
; Same idea as min16s, but only the MSBs are compared with flipped sign
; bits, in registers, so neither value in memory is modified. If the MSBs
; are equal, the signs are equal and the unsigned routine decides.
min32s:
    psh a, b
    lod a, [x:y]
    xor a, 0x80
    lod b, [i:j]
    xor b, 0x80
    cmp a, b
    pop a, b                ; pop leaves S, E and F alone
    jme min32               ; same MSB: min32 returns to our caller
    jmf min32s_keep
    cal copy32
min32s_keep:
    ret

max32s:
    psh a, b
    lod a, [x:y]
    xor a, 0x80
    lod b, [i:j]
    xor b, 0x80
    cmp a, b
    pop a, b
    jme max32               ; same MSB: max32 returns to our caller
    jms max32s_keep
    cal copy32
max32s_keep:
    ret

; ------------------------------------------------------------
; sext16: 32-bit value at [x:y] = [a:b] sign-extended
;         (0x8000 -> 0xFFFF8000)
; ------------------------------------------------------------
sext16:
    str [x:y + 2], a        ; low half = [a:b]
    str [x:y + 3], b
    psh a
    or a, 0                 ; N = sign bit
    mov a, 0                ; positive: high half = 0 (mov leaves N alone)
    jmn sext16_neg
sext16_store:
    str [x:y], a
    str [x:y + 1], a
    pop a
    ret
sext16_neg:
    mov a, 0xFF
    jmp sext16_store
