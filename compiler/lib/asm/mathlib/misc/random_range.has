; ============================================================
; Random numbers in a range
; ============================================================
; Uses rand8, rand16 and rand_step from random.has.

; Method: span = hi - lo, mask = the smallest 0b0..01..1 >= span. Take a
; random number, keep the bits of the mask, and try again while it is
; above span (fewer than 2 tries on average). Then add lo.
; Every value of the range is equally likely: no "% n" bias, no division.
; Not reentrant, like rand8 / rand16 / rand32.

; ------------------------------------------------------------
; randr8: a = random number from a to b (included), unsigned
; flags: C = b < a (then nothing changes)
; ------------------------------------------------------------
randr8:
    psh b, c, d, i, j, x
    cmp b, a
    jmf randr8_error
    sub b, a                ; b = span
    mov c, a                ; c = lo
    mov i, 0
    mov j, b
    cal randr_mask8
    mov d, j                ; d = mask
randr8_loop:
    cal rand8               ; a = random (keeps the other registers)
    and a, d
    cmp a, b
    jms randr8_loop         ; above span: again
    add a, c
    pop b, c, d, i, j, x
    clc
    ret
randr8_error:
    pop b, c, d, i, j, x
    stc
    ret

; ------------------------------------------------------------
; randr16: [a:b] = random number from [a:b] to [c:d] (included), unsigned
; flags: C = [c:d] < [a:b] (then nothing changes)
; ------------------------------------------------------------
randr16:
    psh c, d, i, j, x, y
    sub d, b                ; [c:d] = span
    sbb c, a
    jmc randr16_error
    psh a, b                ; lo
    mov i, 0
    mov j, c
    cal randr_mask8
    mov y, j                ; mask MSB (randr_mask8 changes x)
    mov j, d
    cal randr_mask8
    mov x, y
    mov y, j                ; [x:y] = mask
randr16_loop:
    cal rand16              ; [a:b] = random (keeps the other registers)
    and a, x
    and b, y
    cmp a, c                ; above span: again
    jms randr16_loop
    jmf randr16_ok
    cmp b, d
    jms randr16_loop
randr16_ok:
    pop i, j                ; [i:j] = lo
    add b, j
    adc a, i
    pop c, d, i, j, x, y
    clc
    ret
randr16_error:
    pop c, d, i, j, x, y
    stc
    ret

; ------------------------------------------------------------
; randr32: 32-bit value at [x:y] = random number from the value at [x:y]
;          to the value at [i:j] (included), unsigned
; flags: C = [i:j] < [x:y] (then nothing changes)
; ------------------------------------------------------------
randr32:
    psh a, b, c, d, i, j, x, y
    lod d, [i:j + 3]        ; [a:b:c:d] = span = hi - lo
    sub d, [x:y + 3]        ; (lod leaves C alone)
    lod c, [i:j + 2]
    sbb c, [x:y + 2]
    lod b, [i:j + 1]
    sbb b, [x:y + 1]
    lod a, [i:j]
    sbb a, [x:y]
    jmc randr32_error       ; hi < lo
    ssp 4                   ; [sp] = mask
    mov i, 0
    mov j, a
    cal randr_mask8
    str [sp], j
    mov j, b
    cal randr_mask8
    str [sp + 1], j
    mov j, c
    cal randr_mask8
    str [sp + 2], j
    mov j, d
    cal randr_mask8
    str [sp + 3], j
    mov i, a                ; [i:j:x:y] = span
    mov j, b
    mov x, c
    mov y, d
randr32_loop:
    cal rand_step           ; [a:b:c:d] = random (keeps i, j, x, y)
    and a, [sp]
    and b, [sp + 1]
    and c, [sp + 2]
    and d, [sp + 3]
    cmp a, i                ; above span: again
    jms randr32_loop
    jmf randr32_ok
    cmp b, j
    jms randr32_loop
    jmf randr32_ok
    cmp c, x
    jms randr32_loop
    jmf randr32_ok
    cmp d, y
    jms randr32_loop
randr32_ok:
    lod x, [sp + 5]         ; [x:y] -> lo
    lod y, [sp + 4]
    add d, [x:y + 3]        ; value = lo + random
    str [x:y + 3], d
    adc c, [x:y + 2]
    str [x:y + 2], c
    adc b, [x:y + 1]
    str [x:y + 1], b
    adc a, [x:y]
    str [x:y], a
    asp 4
    pop a, b, c, d, i, j, x, y
    clc
    ret
randr32_error:
    pop a, b, c, d, i, j, x, y
    stc
    ret

; One byte of the mask, from the MSB down: j = byte of span, i = 0 until
; a byte that is not 0 has been seen (then 0xFF). Returns the mask byte
; in j: 0xFF once i = 0xFF, else the smallest 0b0..01..1 >= j.
; Changes x.
randr_mask8:
    or i, 0
    jmz randr_mask8_first
    mov j, 0xFF             ; below the highest 1: all bits
    ret
randr_mask8_first:
    mov x, 0
randr_mask8_loop:
    cmp x, j
    jme randr_mask8_end
    jms randr_mask8_end
    add x, x                ; x = x * 2 + 1
    inc x
    mov i, 0xFF
    jmp randr_mask8_loop
randr_mask8_end:
    mov j, x
    ret
