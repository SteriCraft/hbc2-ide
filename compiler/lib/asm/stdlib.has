; stdlib.h functions written in assembly.

; void exit(int status): ends the program with status in [a:b], as if
; main had returned it (crt0.has).
_exit:
    lod a, [sp + 2]
    lod b, [sp + 3]
    wsp $0xFE00                 ; the stack as main left it
    jmp __exit

; int abs(int n), long labs(long n)
_abs:
    lod a, [sp + 2]
    lod b, [sp + 3]
    jmp abs16

_labs:
    rsp [x:y]
    add y, 2                    ; [x:y] -> n (changed in place)
    adc x, 0
    cal abs32
    jmp lib_math_load           ; asm/math.has

; --- Random numbers ------------------------------------------------------

; int rand(void): 0 to RAND_MAX (32767)
_rand:
    cal rand16
    and a, 0x7F
    ret

; void srand(unsigned seed): state = seed : ~seed (never 0), mixed by 8
; steps so that seeds next to each other give unrelated numbers.
_srand:
    lod a, [sp + 2]
    lod b, [sp + 3]
    mov c, a
    mov d, b
    not c
    not d
    str rand_s, a
    str rand_s + 1, b
    str rand_s + 2, c
    str rand_s + 3, d
    mov i, 8
lib_srand_mix:
    cal rand_step               ; keeps i
    dec i
    jmz lib_srand_end
    jmp lib_srand_mix
lib_srand_end:
    ret

; --- Number <-> text -----------------------------------------------------

; Number to text, for C: the digits of itoa, utoa, ltoa, ultoa
; (src/stdlib.c) and printf (src/printf.c). Not in a header: those
; files declare them. Each writes value at buf, 0-terminated, and returns
; the end of the text (the 0): the length is end - buf.

; char *__itoa_dec(int value, char *buf): signed decimal, 7 bytes
___itoa_dec:
    lod a, [sp + 2]
    lod b, [sp + 3]
    lod x, [sp + 4]
    lod y, [sp + 5]
    cal itoa16
lib_text_end:                   ; returns [x:y], on the 0
    mov a, x
    mov b, y
    ret

; char *__utoa_dec(unsigned value, char *buf): decimal, 6 bytes
___utoa_dec:
    lod a, [sp + 2]
    lod b, [sp + 3]
    lod x, [sp + 4]
    lod y, [sp + 5]
    cal utoa16
    jmp lib_text_end

; char *__utoa_hex(unsigned value, char *buf): 4 hexadecimal digits
; (upper case, leading zeros kept), 5 bytes
___utoa_hex:
    lod a, [sp + 2]
    lod b, [sp + 3]
    lod x, [sp + 4]
    lod y, [sp + 5]
    cal htoa16
    jmp lib_text_end

; The long ones read the value where it is, on the stack: [i:j] -> value.

; char *__ltoa_dec(long value, char *buf): signed decimal, 12 bytes
___ltoa_dec:
    cal lib_text_long
    cal itoa32
    jmp lib_text_end

; char *__ultoa_dec(unsigned long value, char *buf): decimal, 11 bytes
___ultoa_dec:
    cal lib_text_long
    cal utoa32
    jmp lib_text_end

; char *__ultoa_hex(unsigned long value, char *buf): 8 hexadecimal
; digits, 9 bytes
___ultoa_hex:
    cal lib_text_long
    cal htoa32
    jmp lib_text_end

; [i:j] -> value, [x:y] = buf, for the long ones (called by them: the
; value is at [sp + 4] here)
lib_text_long:
    lod x, [sp + 8]
    lod y, [sp + 9]
    rsp [i:j]
    add j, 4
    adc i, 0
    ret
