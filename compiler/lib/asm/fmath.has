; math.h float functions: wrappers of the float library (asm/math/float).
; float and double are the same type, so sin and sinf are the same code.
; The library works on a float in memory at [x:y] (and [i:j] for a second
; one): the wrappers give it the C arguments themselves, on the stack (a C
; function may change its arguments), then load the result into
; [c:d]:[a:b]. lib_math_arg / lib_math_load are in asm/math.has.

; [x:y] -> the first argument, [i:j] -> the second (4 bytes further), for a
; wrapper called directly from C
lib_fmath_args2:
    rsp [x:y]
    add y, 4
    adc x, 0
    mov i, x
    mov j, y
    add j, 4
    adc i, 0
    ret

; [a:b] = a (0 or 1, a class...): the int result of a predicate
lib_fmath_int:
    mov b, a
    mov a, 0
    ret

; --- one float argument, float result -----------------------------------
_sin:
    cal lib_math_arg
    cal fsin
    jmp lib_math_load
_sinf:
    cal lib_math_arg
    cal fsin
    jmp lib_math_load
