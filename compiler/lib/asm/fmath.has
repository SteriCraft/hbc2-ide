; --- ldexp, frexp, modf -----------------------------------------------------

; (each C name has its own entry: a program may replace one of them)

; double ldexp(double x, int exp)
_ldexp:
    jmp lib_fmath_ldexp
_ldexpf:
lib_fmath_ldexp:
    lod a, [sp + 6]
    lod b, [sp + 7]
    cal lib_math_arg
    cal ldexp
    jmp lib_math_load

; double frexp(double x, int *exp)
_frexp:
    jmp lib_fmath_frexp
_frexpf:
lib_fmath_frexp:
    cal lib_math_arg
    cal frexp                   ; [a:b] = the exponent
    lod i, [sp + 6]
    lod j, [sp + 7]
    str [i:j], a
    str [i:j + 1], b
    jmp lib_math_load

; double modf(double x, double *iptr): *iptr = trunc(x), the result is
; x - *iptr with the sign of x (modf(-3) = -0); modf(+-inf) = +-0
_modf:
    jmp lib_fmath_modf
_modff:
lib_fmath_modf:
    cal lib_math_arg
    lod i, [sp + 6]
    lod j, [sp + 7]
    lod a, [x:y]                ; *iptr = x
    str [i:j], a
    lod a, [x:y + 1]
    str [i:j + 1], a
    lod a, [x:y + 2]
    str [i:j + 2], a
    lod a, [x:y + 3]
    str [i:j + 3], a
    psh x, y
    mov x, i
    mov y, j
    cal ftrunc                  ; *iptr = trunc(x)
    pop x, y
    cal fisinf
    jmz lib_fmath_modf_sub
    lod a, [x:y]                ; infinity: +-0
    and a, 0x80
    str [x:y], a
    mov a, 0
    str [x:y + 1], a
    str [x:y + 2], a
    str [x:y + 3], a
    jmp lib_math_load
lib_fmath_modf_sub:
    cal fsub                    ; x - trunc(x): exact
    cal fcopysign               ; the sign of trunc(x) = the sign of x
    jmp lib_math_load

; --- fenv.h -----------------------------------------------------------------
; The flags are the byte fenv_flags of the float library (asm/math/float/
; fenv.has). fexcept_t and fenv_t are one byte (the flags). Only rounding
; to nearest exists. Every function returns 0 (success), but fesetround of
; another mode (1) and fetestexcept (the flags).

; int feclearexcept(int excepts)
_feclearexcept:
    lod a, [sp + 3]
    cal fe_clear
    jmp lib_fenv_ok

; int feraiseexcept(int excepts)
_feraiseexcept:
    lod a, [sp + 3]
    and a, FE_ALL_EXCEPT
    cal fe_raise
    jmp lib_fenv_ok

; int fetestexcept(int excepts): the ones that are raised
_fetestexcept:
    lod a, [sp + 3]
    cal fe_test
    mov b, a
    mov a, 0
    ret

; int fegetexceptflag(fexcept_t *flagp, int excepts)
_fegetexceptflag:
    lod a, [sp + 5]
    cal fe_test
    lod x, [sp + 2]
    lod y, [sp + 3]
    str [x:y], a
    jmp lib_fenv_ok

; int fesetexceptflag(const fexcept_t *flagp, int excepts): the flags of
; excepts take their state in *flagp
_fesetexceptflag:
    lod a, [sp + 5]
    cal fe_clear
    lod x, [sp + 2]
    lod y, [sp + 3]
    lod b, [x:y]
    and a, b
    and a, FE_ALL_EXCEPT
    cal fe_raise
    jmp lib_fenv_ok

; int fegetround(void)
_fegetround:
    jmp lib_fenv_ok             ; FE_TONEAREST = 0

; int fesetround(int round): only FE_TONEAREST (0) works
_fesetround:
    lod a, [sp + 2]
    or a, [sp + 3]
    jmz lib_fenv_ok
    mov a, 0
    mov b, 1
    ret

; int fegetenv(fenv_t *envp)
_fegetenv:
    lod x, [sp + 2]
    lod y, [sp + 3]
    cal fe_get
    str [x:y], a
    jmp lib_fenv_ok

; int feholdexcept(fenv_t *envp): saves the flags, then clears them
_feholdexcept:
    lod x, [sp + 2]
    lod y, [sp + 3]
    cal fe_get
    str [x:y], a
    mov a, 0
    cal fe_set
    jmp lib_fenv_ok

; int fesetenv(const fenv_t *envp)
_fesetenv:
    lod x, [sp + 2]
    lod y, [sp + 3]
    lod a, [x:y]
    cal fe_set
    jmp lib_fenv_ok

; int feupdateenv(const fenv_t *envp): the saved flags, plus the ones raised
; since
_feupdateenv:
    lod x, [sp + 2]
    lod y, [sp + 3]
    cal fe_get
    mov b, a
    lod a, [x:y]
    or a, b
    cal fe_set
lib_fenv_ok:
    mov a, 0
    mov b, 0
    ret

; const fenv_t __fe_dfl_env: FE_DFL_ENV, no flag raised
.data ___fe_dfl_env 0

; --- strtod, strtof, atof (stdlib.h) -----------------------------------------

; double strtod(const char *str, char **str_end): spaces (' ', \t to \r)
; first, then the text of atof (asm/math/float/fatof.has). *str_end (when
; str_end is not NULL) = the first character not read, or str when there is
; no number (the result is 0 then). errno = ERANGE when the result overflows
; (+-HUGE_VAL) or underflows (a subnormal or 0 that is not exact).
_strtod:
    jmp lib_strtod
_strtof:
lib_strtod:
    lod i, [sp + 2]
    lod j, [sp + 3]
lib_strtod_space:
    lod a, [i:j]
    cmp a, ' '
    jme lib_strtod_next
    sub a, 9                    ; \t to \r
    cmp a, 5
    jmf lib_strtod_next
    jmp lib_strtod_go
lib_strtod_next:
    add j, 1
    adc i, 0
    jmp lib_strtod_space
lib_strtod_go:
    cal fe_get                  ; the flags of the program, kept apart
    psh a
    mov a, 0
    cal fe_set
    ssp 4                       ; the result
    rsp [x:y]
    cal atof
    jmc lib_strtod_none
    cal fe_get                  ; overflow or underflow: ERANGE
    and a, 0x0C
    jmz lib_strtod_end
    mov a, 0
    mov b, 2
    str _errno, a
    str _errno + 1, b
    jmp lib_strtod_end
lib_strtod_none:
    mov a, 0                    ; no number: 0, and the end is str
    str [x:y], a
    str [x:y + 1], a
    str [x:y + 2], a
    str [x:y + 3], a
    lod i, [sp + 7]
    lod j, [sp + 8]
lib_strtod_end:
    lod a, [sp + 9]             ; str_end
    lod b, [sp + 10]
    or a, b
    jmz lib_strtod_res
    lod a, [sp + 9]
    mov x, a
    mov y, b
    str [x:y], i
    str [x:y + 1], j
lib_strtod_res:
    lod b, [sp + 4]             ; the program's flags, plus the new ones
    cal fe_get
    or a, b
    cal fe_set
    rsp [x:y]
    cal lib_math_load
    asp 5
    ret

; double atof(const char *str): strtod(str, NULL)
_atof:
    lod a, [sp + 2]
    lod b, [sp + 3]
    mov c, 0
    mov d, 0
    psh d, c, b, a
    cal _strtod
    asp 4
    ret
