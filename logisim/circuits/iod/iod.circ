    <comp lib="9" loc="(1030,140)" name="Text">
      <a name="text" val="TX strobe: /Y0 OR clk_wr_n"/>
    </comp>
    <comp lib="9" loc="(1030,500)" name="Text">
      <a name="text" val="evt_s = INT (on clk, 0 in the vector step) | spare"/>
    </comp>
    <comp lib="9" loc="(1040,940)" name="Text">
      <a name="text" val="EVT port -&gt; bus_addr A0-A7 (vector step)"/>
    </comp>
    <comp lib="9" loc="(1470,140)" name="Text">
      <a name="text" val="TX full (CPU sets, MCU clears) | RX full (MCU sets, CPU clears)"/>
    </comp>
    <comp lib="9" loc="(1470,500)" name="Text">
      <a name="text" val="TX: loaded from bus_data, shifted out to the MCU (bit 7 first)"/>
    </comp>
    <comp lib="9" loc="(1480,940)" name="Text">
      <a name="text" val="EVT data -&gt; bus_data (vector step, -&gt; I)"/>
    </comp>
    <comp lib="9" loc="(1910,1000)" name="Text">
      <a name="text" val="74LVC244 at 3.3 V: to the ESP32"/>
    </comp>
    <comp lib="9" loc="(1910,140)" name="Text">
      <a name="text" val="rx_clr (step after IN RX) | EVT pending (MCU sets)"/>
    </comp>
    <comp lib="9" loc="(1910,500)" name="Text">
      <a name="text" val="STATUS: RX full, TX free, EVT pending, 0 x 5"/>
    </comp>
    <comp lib="9" loc="(590,140)" name="Text">
      <a name="text" val="decode: /Y0 OUT TX, /Y2 IN RX, /Y3 IN STATUS"/>
    </comp>
    <comp lib="9" loc="(590,500)" name="Text">
      <a name="text" val="evt_clr (step after the vector step) | VEC (INR delayed one step)"/>
    </comp>
    <comp lib="9" loc="(600,940)" name="Text">
      <a name="text" val="RX: from the MCU -&gt; bus_data (IN RX)"/>
    </comp>
