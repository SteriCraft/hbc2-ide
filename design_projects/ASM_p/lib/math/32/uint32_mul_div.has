; ------------------------------------------------------------
; mul32: 32-bit value at [x:y] *= 32-bit value at [i:j] (unsigned)
; flags: C = overflow (the product needs more than 32 bits; its low
;        32 bits are stored)
; ------------------------------------------------------------
; Shift-and-add from the multiplier's MSB, in registers: product in
; [a:b:c:d], multiplier byte in x, y counts the bits lost at the top
; (overflow if it is not 0). The ALU reads the multiplicand at [i:j]
; directly. The multiplier bytes are pushed on the stack (LSB first), so
; that each one is popped in turn, MSB first.
; A multiplier byte of 0 is a byte move instead of 8 steps.
; [x:y] and [i:j] can be the same address (squaring).
mul32:
    psh a, b, c, d, i, j, x, y
    lod a, [x:y + 3]            ; multiplier bytes on the stack, LSB first
    psh a
    lod a, [x:y + 2]
    psh a
    lod a, [x:y + 1]
    psh a
    lod a, [x:y]
    psh a                       ; [sp] = MSB
    mov a, 0                    ; product = 0
    mov b, 0
    mov c, 0
    mov d, 0
    mov y, 0                    ; no bit lost yet
    pop x                       ; byte 0 (MSB)
    cal mul32_byte
    pop x                       ; byte 1
    cal mul32_byte
    pop x                       ; byte 2
    cal mul32_byte
    pop x                       ; byte 3 (LSB)
    cal mul32_byte
    mov i, y                    ; i = bits lost
    lod x, [sp + 1]             ; [x:y] -> product
    lod y, [sp]
    str [x:y], a
    str [x:y + 1], b
    str [x:y + 2], c
    str [x:y + 3], d
    clc
    or i, 0                     ; or leaves C alone
    jmz mul32_end
    stc
mul32_end:
    pop a, b, c, d, i, j, x, y
    ret

mul32_zero:                     ; byte 0: product <<= 8
    or a, 0
    jmz mul32_move
    inc y                       ; a non-zero byte is lost
mul32_move:
    mov a, b
    mov b, c
    mov c, d
    mov d, 0
    ret

; One multiplier byte x: a byte move if it is 0, else 8 steps.
mul32_byte:
    or x, 0
    jmz mul32_zero
                                ; falls through
; 8 steps: the 8 bits of multiplier byte x.
mul32_8:
    add d, d                ; step 1: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add1
    jmp mul32_next1
mul32_add1:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next1:
    add d, d                ; step 2: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add2
    jmp mul32_next2
mul32_add2:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next2:
    add d, d                ; step 3: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add3
    jmp mul32_next3
mul32_add3:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next3:
    add d, d                ; step 4: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add4
    jmp mul32_next4
mul32_add4:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next4:
    add d, d                ; step 5: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add5
    jmp mul32_next5
mul32_add5:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next5:
    add d, d                ; step 6: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add6
    jmp mul32_next6
mul32_add6:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next6:
    add d, d                ; step 7: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add7
    jmp mul32_next7
mul32_add7:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next7:
    add d, d                ; step 8: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc y, 0                ; counts the bits lost at the top
    add x, x                ; C = multiplier bit
    jmc mul32_add8
    jmp mul32_next8
mul32_add8:
    add d, [i:j + 3]        ; product += multiplicand
    adc c, [i:j + 2]
    adc b, [i:j + 1]
    adc a, [i:j]
    adc y, 0
mul32_next8:
    ret

; ------------------------------------------------------------
; div32: 32-bit value at [x:y] /= 32-bit value at [i:j] (unsigned), and the value at [i:j] = remainder
; flags: C = division by zero (then nothing changes)
; ------------------------------------------------------------
; Shift-and-subtract, in registers: [a:b:c:d] = remainder, [i:j:x:y] =
; dividend, then quotient. The divisor is pushed on the stack (MSB at
; [sp]), where the ALU reads it directly.
; Leading zero bytes of the dividend are skipped: they would only bring
; zeros into the remainder.
div32:
    psh a, b, c, d, i, j, x, y
    lod a, [i:j]                ; divisor
    lod b, [i:j + 1]
    lod c, [i:j + 2]
    lod d, [i:j + 3]
    psh d, c, b, a              ; [sp] = MSB ... [sp + 3] = LSB
    or a, b
    or a, c
    or a, d
    jmz div32_zero
    lod i, [x:y]                ; [i:j:x:y] = dividend
    lod j, [x:y + 1]
    lod a, [x:y + 3]
    lod x, [x:y + 2]
    mov y, a
    mov a, 0                    ; remainder = 0
    mov b, 0
    mov c, 0
    mov d, 0
    or i, 0
    jmz div32_skip1             ; leading zero byte
    cal div32_8                 ; 4 dividend bytes
div32_3:
    cal div32_8                 ; 3 bytes left
div32_2:
    cal div32_8                 ; 2 bytes left
div32_1:
    cal div32_8                 ; 1 byte left
div32_store:
    str [sp], i                 ; the divisor is not needed any more:
    str [sp + 1], j             ; the quotient waits there
    str [sp + 2], x
    str [sp + 3], y
    lod i, [sp + 7]             ; [i:j] -> remainder
    lod j, [sp + 6]
    str [i:j], a
    str [i:j + 1], b
    str [i:j + 2], c
    str [i:j + 3], d
    lod x, [sp + 5]             ; [x:y] -> quotient
    lod y, [sp + 4]
    lod a, [sp]
    str [x:y], a
    lod a, [sp + 1]
    str [x:y + 1], a
    lod a, [sp + 2]
    str [x:y + 2], a
    lod a, [sp + 3]
    str [x:y + 3], a
    asp 4
    pop a, b, c, d, i, j, x, y
    clc
    ret
div32_skip1:                    ; dividend <<= 8
    mov i, j
    mov j, x
    mov x, y
    mov y, 0
    or i, 0
    jmz div32_skip2
    jmp div32_3
div32_skip2:
    mov i, j
    mov j, x
    mov x, 0
    or i, 0
    jmz div32_skip3
    jmp div32_2
div32_skip3:
    mov i, j
    mov j, 0
    or i, 0
    jmz div32_store             ; dividend 0: quotient and remainder 0
    jmp div32_1
div32_zero:
    asp 4
    pop a, b, c, d, i, j, x, y
    stc
    ret

; 8 steps: the next 8 dividend bits. The divisor is at [sp + 2] (under
; the return address).
div32_8:
    add y, y                ; step 1: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big1
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo1       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next1
div32_big1:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next1
div32_undo1:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next1:
    add y, y                ; step 2: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big2
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo2       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next2
div32_big2:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next2
div32_undo2:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next2:
    add y, y                ; step 3: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big3
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo3       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next3
div32_big3:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next3
div32_undo3:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next3:
    add y, y                ; step 4: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big4
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo4       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next4
div32_big4:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next4
div32_undo4:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next4:
    add y, y                ; step 5: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big5
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo5       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next5
div32_big5:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next5
div32_undo5:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next5:
    add y, y                ; step 6: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big6
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo6       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next6
div32_big6:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next6
div32_undo6:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next6:
    add y, y                ; step 7: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big7
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo7       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next7
div32_big7:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next7
div32_undo7:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next7:
    add y, y                ; step 8: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big8
    sub d, [sp + 5]         ; remainder -= divisor
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    jmc div32_undo8       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next8
div32_big8:               ; 33-bit remainder: always >= divisor
    sub d, [sp + 5]
    sbb c, [sp + 4]
    sbb b, [sp + 3]
    sbb a, [sp + 2]
    inc y
    jmp div32_next8
div32_undo8:
    add d, [sp + 5]
    adc c, [sp + 4]
    adc b, [sp + 3]
    adc a, [sp + 2]
div32_next8:
    ret

; ------------------------------------------------------------
; pow32: 32-bit value at [x:y] = value ^ c (unsigned; c = exponent,
;        0 to 255)
; flags: C = overflow (the result needs more than 32 bits; its low
;        32 bits are stored)
; ------------------------------------------------------------
; Same method as pow16. The base is copied on the stack, where it is
; squared each round; the result grows at [x:y].
pow32:
    psh a, b, c, i, j
    ssp 4                       ; [sp] = base
    lod a, [x:y]
    str [sp], a
    lod a, [x:y + 1]
    str [sp + 1], a
    lod a, [x:y + 2]
    str [sp + 2], a
    lod a, [x:y + 3]
    str [sp + 3], a
    mov a, 0                    ; result = 1
    str [x:y], a
    str [x:y + 1], a
    str [x:y + 2], a
    mov a, 1
    str [x:y + 3], a
    rsp [i:j]                   ; [i:j] -> base
    mov a, c                    ; a = exponent bits not used yet
    mov b, 0                    ; b = 1 after an overflow
pow32_loop:
    mov c, a
    and c, 1
    jmz pow32_square
    cal mul32                   ; result *= base
    jmc pow32_mul_ovf
    jmp pow32_square
pow32_mul_ovf:
    mov b, 1
pow32_square:
    shr a
    cmp a, 0
    jme pow32_done              ; no more bits
    psh x, y
    mov x, i                    ; base *= base
    mov y, j
    cal mul32
    pop x, y                    ; pop leaves C alone
    jmc pow32_square_ovf
    jmp pow32_loop
pow32_square_ovf:
    mov b, 1
    jmp pow32_loop
pow32_done:
    clc
    cmp b, 0
    jme pow32_end
    stc
pow32_end:
    asp 4
    pop a, b, c, i, j
    ret
