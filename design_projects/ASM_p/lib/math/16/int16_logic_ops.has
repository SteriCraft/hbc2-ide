; ------------------------------------------------------------
; and16: [a:b] = [a:b] AND [c:d]
; or16:  [a:b] = [a:b] OR  [c:d]
; xor16: [a:b] = [a:b] XOR [c:d]
; not16: [a:b] = NOT [a:b]
; flags: Z = result is 0, N = bit 15 of the result (C is unchanged)
; ------------------------------------------------------------
; The two instructions alone would leave Z and N about b only: the
; flags are then fixed for the whole 16-bit result.

and16:
    and a, c
    and b, d
    jmp logic16_flags

or16:
    or a, c
    or b, d
    jmp logic16_flags

xor16:
    xor a, c
    xor b, d
    jmp logic16_flags

not16:
    not a
    not b
                            ; falls through
logic16_flags:              ; Z = (b = 0) here
    jmz logic16_b0
    or a, 0                 ; N = bit 15
    clz                     ; result is not 0 (even if a is)
    ret
logic16_b0:
    or a, 0                 ; b = 0: a decides both Z and N
    ret

; ------------------------------------------------------------
; shl16: [a:b] = [a:b] << 1
; flags: C = bit shifted out
; ------------------------------------------------------------
shl16:
    add b, b                ; b * 2, C = bit 7 of b
    adc a, a                ; a * 2 + C, C = bit 7 of a
    ret

; ------------------------------------------------------------
; shr16: [a:b] = [a:b] >> 1 (unsigned: a 0 comes in at the top)
; asr16: [a:b] = [a:b] >> 1 (signed: the sign bit is kept)
; flags: C = bit shifted out
; ------------------------------------------------------------
; The CPU has no shift right through the carry, so each byte is shifted
; with asr (C = its bit 0), then its top bit is set to the bit that came
; out of the byte above: and / or leave C alone.
shr16:
    asr a                   ; C = bit 0 of a
    and a, 0x7F             ; 0 comes in at the top
    jmp shr16_b
asr16:
    asr a                   ; C = bit 0 of a, sign bit kept
shr16_b:
    jmc shr16_b1
    asr b                   ; C = bit 0 of b
    and b, 0x7F             ; bit 7 = 0 from a
    ret
shr16_b1:
    asr b
    or b, 0x80              ; bit 7 = 1 from a
    ret

; ------------------------------------------------------------
; shl16n: [a:b] = [a:b] << c
; shr16n: [a:b] = [a:b] >> c (unsigned)
; asr16n: [a:b] = [a:b] >> c (signed)
; flags: C = last bit shifted out (0 when c = 0)
; ------------------------------------------------------------
; Whole bytes first (a shift by 8 is a byte move), then the 0 to 7 bits
; left one at a time. At 16 bits or more the result is 0 (or all sign
; bits for asr16n). The count changes come before the shifts: sub and
; dec change C, which must hold the last bit out.
shl16n:
    psh c
    cal shift16n_count
shl16n_bytes:
    cmp c, 8                ; cmp leaves C alone
    jmf shl16n_bits
    sub c, 8
    asr a                   ; C = bit 0 of a: last bit out of the 8
    mov a, b
    mov b, 0
    jmp shl16n_bytes
shl16n_bits:
    or c, 0                 ; or leaves C alone
    jmz shl16n_end
    dec c
    add b, b
    adc a, a
    jmp shl16n_bits
shl16n_end:
    pop c
    ret

asr16n:
    psh c, d
    mov d, 0                ; d = byte coming in at the top
    or a, 0
    jmn asr16n_neg
    jmp shr16n_go
asr16n_neg:
    mov d, 0xFF
    jmp shr16n_go
shr16n:
    psh c, d
    mov d, 0
shr16n_go:
    cal shift16n_count
shr16n_bytes:
    cmp c, 8
    jmf shr16n_bits
    sub c, 8
    shl b                   ; C = bit 7 of b: last bit out of the 8
    mov b, a
    mov a, d
    jmp shr16n_bytes
shr16n_bits:                ; d = 0: 0 comes in, d = 0xFF: 1 comes in
    or c, 0
    jmz shr16n_end
    dec c
    or d, 0
    jmz shr16n_zero
    cal asr16
    jmp shr16n_bits
shr16n_zero:                ; also right for asr16n on a positive value
    cal shr16
    jmp shr16n_bits
shr16n_end:
    pop c, d
    ret

; c = min(c, 17): past 17 the result and C no longer change. C = 0.
shift16n_count:
    cmp c, 18
    jmf shift16n_count_ok
    mov c, 17
shift16n_count_ok:
    clc
    ret
