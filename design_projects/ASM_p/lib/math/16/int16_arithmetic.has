; ------------------------------------------------------------
; cmp16s: compares [a:b] with [c:d] (signed), like cmp
; flags: S = [a:b] > [c:d], E = equal, F = [a:b] < [c:d]
; ------------------------------------------------------------
; Flipping the sign bits maps -32768..32767 onto 0..65535 in the same
; order; xor leaves S, E and F alone.
cmp16s:
    xor a, 0x80
    xor c, 0x80
    cal cmp16
    xor a, 0x80
    xor c, 0x80
    ret

; ------------------------------------------------------------
; add16s: [a:b] = [a:b] + [c:d] (signed)
; flags: C = signed overflow (the result is outside -32768..32767),
;        Z = result is 0
; ------------------------------------------------------------
; Overflow happens when both operands have the same sign and the result
; has the other one: bit 7 of (op1 ^ result) & (op2 ^ result).
add16s:
    psh i, j
    mov i, a                ; i = MSB of op1
    add b, d
    adc a, c
    xor i, a                ; op1 ^ result
    mov j, c
    xor j, a                ; op2 ^ result
    and i, j
    and i, 0x80
    clc
    jmz add16s_z
    stc
add16s_z:
    mov i, a                ; Z = (a | b) == 0, C untouched
    or i, b
    pop i, j
    ret

; ------------------------------------------------------------
; sub16s: [a:b] = [a:b] - [c:d] (signed)
; flags: C = signed overflow (the result is outside -32768..32767),
;        Z = result is 0
; ------------------------------------------------------------
; Overflow happens when the operands have different signs and the result
; has the sign of op2: bit 7 of (op1 ^ op2) & (op1 ^ result).
sub16s:
    psh i, j
    mov i, a                ; i = MSB of op1
    sub b, d
    sbb a, c
    mov j, i
    xor j, c                ; op1 ^ op2
    xor i, a                ; op1 ^ result
    and i, j
    and i, 0x80
    clc
    jmz sub16s_z
    stc
sub16s_z:
    mov i, a
    or i, b
    pop i, j
    ret
