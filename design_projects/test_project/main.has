; === DEFINES ===


; === VARIABLES ===


; === LIBRARIES ===
.include "interruptHandler.has"
.include "lib/monitor/terminal.has"

.include "lib/math/math.has"


; === PROGRAM ===
; Terminal: reads a line, then shows a new prompt (no commands yet).
_start:
    cal term_init               ; clears the screen, '>' and '_' on the top row

_loop:
    cal term_readline           ; waits for Enter: a = length, text in term_line
    cal term_prompt
    jmp _loop
