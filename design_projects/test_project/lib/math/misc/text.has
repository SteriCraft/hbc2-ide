; ============================================================
; Number <-> text conversions
; ============================================================
; Output text is 0-terminated and written at [x:y]. [x:y] is left on
; that 0, so the next text can follow straight after it.
; Buffer sizes (with the 0): utoa 4/6/11, itoa 5/7/12, htoa 3/5/9 bytes.
; Every other register is restored. Flags are changed.

; ------------------------------------------------------------
; utoa8:  a = value          -> decimal text at [x:y]
; utoa16: [a:b] = value      -> decimal text at [x:y]
; utoa32: [i:j] -> value     -> decimal text at [x:y]
; itoa8 / itoa16 / itoa32: same, signed (a '-' first when negative)
; ------------------------------------------------------------
; Each digit is the number of times its power of ten can be subtracted
; (at most 9 times), from the largest power down: the digits come out in
; reading order and no division is needed. j = 1 once a digit has been
; written, so leading zeros are skipped. The last digit is always written.

utoa8:
    psh a, b, c, d, i, j
utoa8_go:                   ; itoa8 enters here
    mov b, a                ; [a:b] = value
    mov a, 0
    mov j, 0
    jmp utoa16_e2

itoa8:
    psh a, b, c, d, i, j
    or a, 0
    jmn itoa8_neg
    jmp utoa8_go
itoa8_neg:
    mov i, '-'
    cal text_putc
    not a                   ; a = -a (-128 gives 128, read unsigned)
    inc a
    jmp utoa8_go

utoa16:
    psh a, b, c, d, i, j
utoa16_go:                  ; itoa16 enters here
    mov j, 0
    mov c, 0x27             ; 10000
    mov d, 0x10
    cal utoa_dig16
utoa16_e3:                  ; utoa32 enters here, value < 10000
    mov c, 0x03             ; 1000
    mov d, 0xE8
    cal utoa_dig16
utoa16_e2:                  ; utoa8 enters here, value < 1000
    mov c, 0
    mov d, 100
    cal utoa_dig16
    mov d, 10
    cal utoa_dig16
    add b, '0'              ; last digit
    mov i, b
    cal text_putc
    mov i, 0
    str [x:y], i            ; terminator, [x:y] stays on it
    pop a, b, c, d, i, j
    ret

itoa16:
    psh a, b, c, d, i, j
    or a, 0
    jmn itoa16_neg
    jmp utoa16_go
itoa16_neg:
    mov i, '-'
    cal text_putc
    not a                   ; [a:b] = -[a:b]
    not b
    add b, 1
    adc a, 0
    jmp utoa16_go

utoa32:
    psh a, b, c, d, i, j
    cal utoa32_load
utoa32_go:                  ; itoa32 enters here
    mov j, 0
    mov i, '0'
utoa32_e9:                  ; 1000000000 = 0x3B9ACA00
    sub d, 0x00
    sbb c, 0xCA
    sbb b, 0x9A
    sbb a, 0x3B
    jmc utoa32_e9_end
    inc i
    jmp utoa32_e9
utoa32_e9_end:
    add d, 0x00
    adc c, 0xCA
    adc b, 0x9A
    adc a, 0x3B
    cal utoa_put
    mov i, '0'
utoa32_e8:                  ; 100000000 = 0x05F5E100
    sub d, 0x00
    sbb c, 0xE1
    sbb b, 0xF5
    sbb a, 0x05
    jmc utoa32_e8_end
    inc i
    jmp utoa32_e8
utoa32_e8_end:
    add d, 0x00
    adc c, 0xE1
    adc b, 0xF5
    adc a, 0x05
    cal utoa_put
    mov i, '0'
utoa32_e7:                  ; 10000000 = 0x00989680
    sub d, 0x80
    sbb c, 0x96
    sbb b, 0x98
    sbb a, 0
    jmc utoa32_e7_end
    inc i
    jmp utoa32_e7
utoa32_e7_end:
    add d, 0x80
    adc c, 0x96
    adc b, 0x98
    adc a, 0
    cal utoa_put
    mov i, '0'
utoa32_e6:                  ; 1000000 = 0x000F4240, value < 0x00989680
    sub d, 0x40
    sbb c, 0x42
    sbb b, 0x0F
    jmc utoa32_e6_end
    inc i
    jmp utoa32_e6
utoa32_e6_end:
    add d, 0x40
    adc c, 0x42
    adc b, 0x0F
    cal utoa_put
    mov i, '0'
utoa32_e5:                  ; 100000 = 0x000186A0
    sub d, 0xA0
    sbb c, 0x86
    sbb b, 0x01
    jmc utoa32_e5_end
    inc i
    jmp utoa32_e5
utoa32_e5_end:
    add d, 0xA0
    adc c, 0x86
    adc b, 0x01
    cal utoa_put
    mov i, '0'
utoa32_e4:                  ; 10000 = 0x00002710
    sub d, 0x10
    sbb c, 0x27
    sbb b, 0
    jmc utoa32_e4_end
    inc i
    jmp utoa32_e4
utoa32_e4_end:
    add d, 0x10
    adc c, 0x27
    adc b, 0
    cal utoa_put
    mov a, c                ; value < 10000: the 16-bit code does the rest
    mov b, d
    jmp utoa16_e3

itoa32:
    psh a, b, c, d, i, j
    cal utoa32_load
    or a, 0
    jmn itoa32_neg
    jmp utoa32_go
itoa32_neg:
    mov i, '-'
    cal text_putc
    not a                   ; [a:b:c:d] = -[a:b:c:d]
    not b
    not c
    not d
    add d, 1
    adc c, 0
    adc b, 0
    adc a, 0
    jmp utoa32_go

; [a:b:c:d] = the 4 bytes at [i:j]. Changes i, j.
utoa32_load:
    lod a, [i:j]
    inc j
    adc i, 0
    lod b, [i:j]
    inc j
    adc i, 0
    lod c, [i:j]
    inc j
    adc i, 0
    lod d, [i:j]
    ret

; One decimal digit: [a:b] = value, [c:d] = power of ten. Writes the
; digit (unless it is a leading zero), [a:b] = value % power. Changes i.
utoa_dig16:
    mov i, '0'
utoa_dig16_loop:
    sub b, d
    sbb a, c
    jmc utoa_dig16_end
    inc i
    jmp utoa_dig16_loop
utoa_dig16_end:
    add b, d                ; one subtraction too many: undo it
    adc a, c
                            ; falls through

; Writes digit i, unless it is a leading zero (i = '0' and j = 0).
; j = 1 once a digit has been written.
utoa_put:
    cmp i, '0'
    jme utoa_put_zero
    mov j, 1
    jmp text_putc
utoa_put_zero:
    cmp j, 0
    jme utoa_put_skip
    jmp text_putc
utoa_put_skip:
    ret

; Writes i at [x:y], then moves [x:y] to the next byte.
text_putc:
    str [x:y], i
    inc y
    adc x, 0
    ret

; ------------------------------------------------------------
; htoa8:  a = value          -> 2 hex digits at [x:y]
; htoa16: [a:b] = value      -> 4 hex digits at [x:y]
; htoa32: [i:j] -> value     -> 8 hex digits at [x:y]
; ------------------------------------------------------------
; Fixed width, upper case, no "0x".

htoa8:
    psh c, d
    mov c, a
    cal htoa_byte
    jmp htoa_end

htoa16:
    psh c, d
    mov c, a
    cal htoa_byte
    mov c, b
    cal htoa_byte
htoa_end:
    mov c, 0
    str [x:y], c            ; terminator, [x:y] stays on it
    pop c, d
    ret

htoa32:
    psh b, c, d, i, j
    mov b, 4                ; 4 bytes, most significant first
htoa32_loop:
    lod c, [i:j]
    cal htoa_byte
    inc j
    adc i, 0
    dec b
    jmz htoa32_end
    jmp htoa32_loop
htoa32_end:
    mov c, 0
    str [x:y], c
    pop b, c, d, i, j
    ret

; Writes byte c as 2 hex digits. Changes c, d.
htoa_byte:
    mov d, c
    shr d
    shr d
    shr d
    shr d
    cal htoa_nib            ; high nibble
    mov d, c
    and d, 0x0F             ; low nibble: falls through
; Writes nibble d (0 to 15) as a hex digit.
htoa_nib:
    add d, '0'
    cmp d, '9'
    jms htoa_nib_af
    jmp htoa_nib_put
htoa_nib_af:
    add d, 7                ; '9' + 1 -> 'A'
htoa_nib_put:
    str [x:y], d
    inc y
    adc x, 0
    ret

; ------------------------------------------------------------
; atou: [i:j] -> decimal text, [x:y] -> 4-byte result (unsigned)
; atoi: same, signed, with an optional '-' or '+' first
; flags: C = error (no digit, or the number does not fit)
; ------------------------------------------------------------
; Reads digits up to the first non-digit and leaves [i:j] on it.
; On error, nothing changes: [i:j] stays put, the result is not written.
; Each digit: value = value * 10 + digit, with value * 10 = value * 2
; + value * 8 (shifts and adds). x is a 5th byte above the value: if it
; is not 0 after a digit, the number has gone past 32 bits.

atou:
    psh a, b, c, d, x, y
    psh i, j                ; to put back on error
    cal atou_read
    jmc atou_error
atou_store:                 ; atoi joins here
    pop x, y                ; drop the saved [i:j]
    pop x, y                ; [x:y] -> result
    psh x, y
    str [x:y], a
    inc y
    adc x, 0
    str [x:y], b
    inc y
    adc x, 0
    str [x:y], c
    inc y
    adc x, 0
    str [x:y], d
    pop x, y
    pop a, b, c, d
    clc
    ret
atou_error:
    pop i, j
    pop a, b, c, d, x, y
    stc
    ret

atoi:
    psh a, b, c, d, x, y
    psh i, j
    lod y, [i:j]
    cmp y, '-'
    jme atoi_sign
    cmp y, '+'
    jme atoi_sign
    mov y, 0                ; no sign
    jmp atoi_read
atoi_sign:
    inc j
    adc i, 0
atoi_read:
    psh y                   ; y = '-' when negative
    cal atou_read
    pop y
    jmc atou_error
    cmp y, '-'
    jme atoi_neg
    or a, 0                 ; positive: at most 0x7FFFFFFF
    jmn atou_error
    jmp atou_store
atoi_neg:                   ; negative: at most 0x80000000
    cmp a, 0x80
    jmf atoi_negate
    jms atou_error
    mov y, b                ; a = 0x80: the rest must be 0
    or y, c
    or y, d
    jmz atoi_negate
    jmp atou_error
atoi_negate:
    not a
    not b
    not c
    not d
    add d, 1
    adc c, 0
    adc b, 0
    adc a, 0
    jmp atou_store

; [a:b:c:d] = the decimal number at [i:j], [i:j] = first non-digit.
; C = no digit or overflow (then [a:b:c:d] and [i:j] are garbage).
; Changes x, y.
atou_read:
    lod y, [i:j]
    sub y, '0'              ; below '0' wraps around past 9
    cmp y, 10
    jmf atou_read_go
    stc                     ; no digit
    ret
atou_read_go:
    mov a, 0
    mov b, 0
    mov c, 0
    mov d, 0
    mov x, 0
atou_read_loop:             ; y = digit at [i:j]
    inc j
    adc i, 0
    psh y
    add d, d                ; [x:a:b:c:d] *= 2
    adc c, c
    adc b, b
    adc a, a
    adc x, x
    psh x, a, b, c, d       ; keep value * 2
    add d, d                ; *= 4: value * 8
    adc c, c
    adc b, b
    adc a, a
    adc x, x
    add d, d
    adc c, c
    adc b, b
    adc a, a
    adc x, x
    pop y                   ; += value * 2, popped from d up
    add d, y                ; (pop does not change the flags)
    pop y
    adc c, y
    pop y
    adc b, y
    pop y
    adc a, y
    pop y
    adc x, y
    pop y                   ; += digit
    add d, y
    adc c, 0
    adc b, 0
    adc a, 0
    adc x, 0
    cmp x, 0
    jme atou_read_next
    stc                     ; past 32 bits
    ret
atou_read_next:
    lod y, [i:j]
    sub y, '0'
    cmp y, 10
    jmf atou_read_loop
    clc
    ret
