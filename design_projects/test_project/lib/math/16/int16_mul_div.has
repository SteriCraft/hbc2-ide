; ------------------------------------------------------------
; mul16s: [a:b:c:d] = [a:b] * [c:d] (signed, full 32-bit product)
; ------------------------------------------------------------
; Multiplies the absolute values, then negates the product if the signs
; differ. abs16 turns -32768 into 0x8000, which is 32768 unsigned: right.
mul16s:
    psh i
    mov i, a
    xor i, c                ; bit 7 = sign of the product
    cal abs16
    psh a, b
    mov a, c
    mov b, d
    cal abs16
    mov c, a
    mov d, b
    pop a, b
    cal mul16
    and i, 0x80
    jmz mul16s_end
    mov i, 0                ; [a:b:c:d] = -[a:b:c:d]
    sub i, d
    mov d, i
    mov i, 0
    sbb i, c
    mov c, i
    mov i, 0
    sbb i, b
    mov b, i
    mov i, 0
    sbb i, a
    mov a, i
mul16s_end:
    pop i
    ret

; ------------------------------------------------------------
; div16s: [a:b] = [a:b] / [c:d], [c:d] = remainder (signed)
; flags: C = division by zero, or -32768 / -1 (the result 32768 does not
;        fit); then nothing changes
; ------------------------------------------------------------
; Like C: the quotient is rounded toward 0 and the remainder has the sign
; of the dividend (-7 / 2 = -3, remainder -1).
div16s:
    psh i, j
    mov i, c
    or i, d
    jmz div16s_err          ; division by zero
    cmp a, 0x80             ; -32768 / -1?
    jme div16s_min
div16s_ok:
    mov i, a                ; bit 7 = sign of the remainder
    mov j, a
    xor j, c                ; bit 7 = sign of the quotient
    cal abs16
    psh a, b
    mov a, c
    mov b, d
    cal abs16
    mov c, a
    mov d, b
    pop a, b
    cal div16
    and j, 0x80
    jmz div16s_rem
    cal neg16
div16s_rem:
    and i, 0x80
    jmz div16s_end
    psh a, b
    mov a, c
    mov b, d
    cal neg16
    mov c, a
    mov d, b
    pop a, b
div16s_end:
    pop i, j
    clc
    ret
div16s_min:
    cmp b, 0
    jme div16s_min_c
    jmp div16s_ok
div16s_min_c:
    cmp c, 0xFF
    jme div16s_min_d
    jmp div16s_ok
div16s_min_d:
    cmp d, 0xFF
    jme div16s_err
    jmp div16s_ok
div16s_err:
    pop i, j
    stc
    ret
