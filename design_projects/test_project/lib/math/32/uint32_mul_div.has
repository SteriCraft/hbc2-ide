; ------------------------------------------------------------
; mul32: 32-bit value at [x:y] *= 32-bit value at [i:j] (unsigned)
; flags: C = overflow (the product needs more than 32 bits; its low
;        32 bits are stored)
; ------------------------------------------------------------
; Shift-and-add from the multiplier's MSB, in registers: product in
; [a:b:c:d], multiplier byte in i, multiplicand copied to mul32_m (the
; ALU reads it from there directly). j counts the bits lost at the top:
; overflow if it is not 0.
; A multiplier byte of 0 is a byte move instead of 8 steps.
; Not reentrant: an interrupt handler must not use it while the main
; program does.
.data32 mul32_m 0               ; multiplicand
.data mul32_n 0                 ; multiplier bytes left

mul32:
    psh a, b, c, d, i, j, x, y
    lod a, [i:j]                ; mul32_m = multiplicand
    str mul32_m, a
    inc j
    adc i, 0
    lod a, [i:j]
    str mul32_m + 1, a
    inc j
    adc i, 0
    lod a, [i:j]
    str mul32_m + 2, a
    inc j
    adc i, 0
    lod a, [i:j]
    str mul32_m + 3, a
    mov a, 4
    str mul32_n, a
    mov a, 0                    ; product = 0
    mov b, 0
    mov c, 0
    mov d, 0
    mov j, 0                    ; no bit lost yet
mul32_loop:                     ; [x:y] -> next multiplier byte, MSB first
    lod i, [x:y]
    or i, 0
    jmz mul32_zero
    cal mul32_8
mul32_byte_done:
    dec mul32_n
    jmz mul32_store
    inc y
    adc x, 0
    jmp mul32_loop
mul32_zero:                     ; byte 0: product <<= 8
    or a, 0
    jmz mul32_move
    inc j                       ; a non-zero byte is lost
mul32_move:
    mov a, b
    mov b, c
    mov c, d
    mov d, 0
    jmp mul32_byte_done
mul32_store:
    pop x, y                    ; [x:y] = product
    psh x, y
    str [x:y], a
    inc y
    adc x, 0
    str [x:y], b
    inc y
    adc x, 0
    str [x:y], c
    inc y
    adc x, 0
    str [x:y], d
    or j, 0
    clc
    jmz mul32_end
    stc
mul32_end:
    pop a, b, c, d, i, j, x, y
    ret

; 8 steps: the 8 bits of multiplier byte i.
mul32_8:
    add d, d                ; step 1: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add1
    jmp mul32_next1
mul32_add1:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next1:
    add d, d                ; step 2: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add2
    jmp mul32_next2
mul32_add2:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next2:
    add d, d                ; step 3: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add3
    jmp mul32_next3
mul32_add3:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next3:
    add d, d                ; step 4: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add4
    jmp mul32_next4
mul32_add4:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next4:
    add d, d                ; step 5: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add5
    jmp mul32_next5
mul32_add5:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next5:
    add d, d                ; step 6: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add6
    jmp mul32_next6
mul32_add6:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next6:
    add d, d                ; step 7: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add7
    jmp mul32_next7
mul32_add7:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next7:
    add d, d                ; step 8: product <<= 1
    adc c, c
    adc b, b
    adc a, a
    adc j, 0                ; counts the bits lost at the top
    add i, i                ; C = multiplier bit
    jmc mul32_add8
    jmp mul32_next8
mul32_add8:
    add d, mul32_m + 3      ; product += multiplicand
    adc c, mul32_m + 2
    adc b, mul32_m + 1
    adc a, mul32_m
    adc j, 0
mul32_next8:
    ret

; ------------------------------------------------------------
; div32: 32-bit value at [x:y] /= 32-bit value at [i:j] (unsigned), and the value at [i:j] = remainder
; flags: C = division by zero (then nothing changes)
; ------------------------------------------------------------
; Shift-and-subtract, in registers: [a:b:c:d] = remainder, [i:j:x:y] =
; dividend, then quotient. The divisor is copied to div32_d (the ALU
; reads it from there directly).
; Leading zero bytes of the dividend are skipped: they would only bring
; zeros into the remainder.
; Not reentrant.
.data32 div32_d 0               ; divisor, then quotient at the end
.data div32_n 0                 ; dividend bytes left

div32:
    psh a, b, c, d, i, j, x, y
    lod a, [i:j]                ; div32_d = divisor
    str div32_d, a
    inc j
    adc i, 0
    lod b, [i:j]
    str div32_d + 1, b
    inc j
    adc i, 0
    lod c, [i:j]
    str div32_d + 2, c
    inc j
    adc i, 0
    lod d, [i:j]
    str div32_d + 3, d
    or a, b
    or a, c
    or a, d
    jmz div32_zero
    lod i, [x:y]                ; [i:j:x:y] = dividend
    inc y
    adc x, 0
    lod j, [x:y]
    inc y
    adc x, 0
    psh i
    lod i, [x:y]
    inc y
    adc x, 0
    lod y, [x:y]
    mov x, i
    pop i
    mov a, 4
    str div32_n, a
    mov a, 0                    ; remainder = 0
    mov b, 0
    mov c, 0
    mov d, 0
div32_skip:                     ; leading zero byte: dividend <<= 8
    or i, 0
    jmz div32_skip_byte
    jmp div32_loop
div32_skip_byte:
    mov i, j
    mov j, x
    mov x, y
    mov y, 0
    dec div32_n
    jmz div32_store             ; dividend 0: quotient and remainder 0
    jmp div32_skip
div32_loop:
    cal div32_8
    dec div32_n
    jmz div32_store
    jmp div32_loop
div32_store:
    str div32_d, i              ; the divisor is not needed any more:
    str div32_d + 1, j          ; the quotient waits there
    str div32_d + 2, x
    str div32_d + 3, y
    pop x, y                    ; [x:y] -> quotient
    pop i, j                    ; [i:j] -> remainder
    psh i, j, x, y
    str [i:j], a
    inc j
    adc i, 0
    str [i:j], b
    inc j
    adc i, 0
    str [i:j], c
    inc j
    adc i, 0
    str [i:j], d
    lod a, div32_d
    str [x:y], a
    inc y
    adc x, 0
    lod a, div32_d + 1
    str [x:y], a
    inc y
    adc x, 0
    lod a, div32_d + 2
    str [x:y], a
    inc y
    adc x, 0
    lod a, div32_d + 3
    str [x:y], a
    pop i, j, x, y
    pop a, b, c, d
    clc
    ret
div32_zero:
    pop a, b, c, d, i, j, x, y
    stc
    ret

; 8 steps: the next 8 dividend bits.
div32_8:
    add y, y                ; step 1: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big1
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo1       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next1
div32_big1:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next1
div32_undo1:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next1:
    add y, y                ; step 2: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big2
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo2       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next2
div32_big2:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next2
div32_undo2:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next2:
    add y, y                ; step 3: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big3
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo3       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next3
div32_big3:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next3
div32_undo3:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next3:
    add y, y                ; step 4: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big4
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo4       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next4
div32_big4:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next4
div32_undo4:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next4:
    add y, y                ; step 5: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big5
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo5       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next5
div32_big5:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next5
div32_undo5:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next5:
    add y, y                ; step 6: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big6
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo6       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next6
div32_big6:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next6
div32_undo6:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next6:
    add y, y                ; step 7: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big7
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo7       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next7
div32_big7:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next7
div32_undo7:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next7:
    add y, y                ; step 8: [a:b:c:d:i:j:x:y] <<= 1
    adc x, x
    adc j, j
    adc i, i
    adc d, d
    adc c, c
    adc b, b
    adc a, a                ; C = bit 32 of the remainder
    jmc div32_big8
    sub d, div32_d + 3      ; remainder -= divisor
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    jmc div32_undo8       ; it was smaller: undo
    inc y                   ; quotient bit = 1
    jmp div32_next8
div32_big8:                ; 33-bit remainder: always >= divisor
    sub d, div32_d + 3
    sbb c, div32_d + 2
    sbb b, div32_d + 1
    sbb a, div32_d
    inc y
    jmp div32_next8
div32_undo8:
    add d, div32_d + 3
    adc c, div32_d + 2
    adc b, div32_d + 1
    adc a, div32_d
div32_next8:
    ret

; ------------------------------------------------------------
; pow32: 32-bit value at [x:y] = value ^ c (unsigned; c = exponent,
;        0 to 255)
; flags: C = overflow (the result needs more than 32 bits; its low
;        32 bits are stored)
; ------------------------------------------------------------
; Same method as pow16. The base is squared in pow32_b. Not reentrant
; (uses pow32_b and mul32_p).
.data32 pow32_b 0               ; base, squared each round
.data32 pow32_one 1

pow32:
    psh a, b, c, i, j
    mov i, x                    ; pow32_b = base
    mov j, y
    psh x, y
    mov x, pow32_b.msb
    mov y, pow32_b.lsb
    cal copy32
    pop x, y
    mov i, pow32_one.msb        ; result = 1
    mov j, pow32_one.lsb
    cal copy32
    mov i, pow32_b.msb          ; [i:j] = base from now on
    mov j, pow32_b.lsb
    mov a, c                    ; a = exponent bits not used yet
    mov b, 0                    ; b = 1 after an overflow
pow32_loop:
    mov c, a
    and c, 1
    jmz pow32_square
    cal mul32                   ; result *= base
    jmc pow32_mul_ovf
    jmp pow32_square
pow32_mul_ovf:
    mov b, 1
pow32_square:
    shr a
    cmp a, 0
    jme pow32_done              ; no more bits
    psh x, y
    mov x, i                    ; base *= base
    mov y, j
    cal mul32
    pop x, y                    ; pop leaves C alone
    jmc pow32_square_ovf
    jmp pow32_loop
pow32_square_ovf:
    mov b, 1
    jmp pow32_loop
pow32_done:
    clc
    cmp b, 0
    jme pow32_end
    stc
pow32_end:
    pop a, b, c, i, j
    ret
