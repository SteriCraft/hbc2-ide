; ------------------------------------------------------------
; add32: 32-bit value at [x:y] += 32-bit value at [i:j]
; flags: C = unsigned overflow, Z = result is 0
; ------------------------------------------------------------
add32:
    psh a, b, c, d, i, j, x, y
    lod a, [i:j]            ; [a:b:c:d] = 2nd operand
    inc j
    adc i, 0
    lod b, [i:j]
    inc j
    adc i, 0
    lod c, [i:j]
    inc j
    adc i, 0
    lod d, [i:j]
    add y, 3                ; [x:y] = LSB of the 1st operand
    adc x, 0
    lod i, [x:y]            ; byte 3 (LSB)
    add i, d
    str [x:y], i
    mov j, i                ; j = OR of the result bytes, for Z
    psf                     ; keep the carry while moving the pointer
    dec y
    sbb x, 0
    pof
    lod i, [x:y]            ; byte 2
    adc i, c
    str [x:y], i
    or j, i
    psf
    dec y
    sbb x, 0
    pof
    lod i, [x:y]            ; byte 1
    adc i, b
    str [x:y], i
    or j, i
    psf
    dec y
    sbb x, 0
    pof
    lod i, [x:y]            ; byte 0 (MSB)
    adc i, a                ; C = carry out
    str [x:y], i
    or j, i                 ; Z = result is 0, C untouched
    pop a, b, c, d, i, j, x, y
    ret

; ------------------------------------------------------------
; sub32: 32-bit value at [x:y] -= 32-bit value at [i:j]
; flags: C = borrow (1st < 2nd unsigned), Z = result is 0
; ------------------------------------------------------------
sub32:
    psh a, b, c, d, i, j, x, y
    lod a, [i:j]            ; [a:b:c:d] = 2nd operand
    inc j
    adc i, 0
    lod b, [i:j]
    inc j
    adc i, 0
    lod c, [i:j]
    inc j
    adc i, 0
    lod d, [i:j]
    add y, 3                ; [x:y] = LSB of the 1st operand
    adc x, 0
    lod i, [x:y]            ; byte 3 (LSB)
    sub i, d
    str [x:y], i
    mov j, i
    psf
    dec y
    sbb x, 0
    pof
    lod i, [x:y]            ; byte 2
    sbb i, c
    str [x:y], i
    or j, i
    psf
    dec y
    sbb x, 0
    pof
    lod i, [x:y]            ; byte 1
    sbb i, b
    str [x:y], i
    or j, i
    psf
    dec y
    sbb x, 0
    pof
    lod i, [x:y]            ; byte 0 (MSB)
    sbb i, a                ; C = borrow
    str [x:y], i
    or j, i
    pop a, b, c, d, i, j, x, y
    ret

; ------------------------------------------------------------
; cmp32: compares the 32-bit values at [x:y] and [i:j] (unsigned), like cmp
; flags: S = [x:y] > [i:j], E = equal, F = [x:y] < [i:j]
; ------------------------------------------------------------
cmp32:
    psh a, i, j, x, y
    lod a, [x:y]            ; byte 0 (MSB)
    cmp a, [i:j]
    jme cmp32_1
    jmp cmp32_done
cmp32_1:                    ; inc / adc leave S, E and F alone
    inc j
    adc i, 0
    inc y
    adc x, 0
    lod a, [x:y]            ; byte 1
    cmp a, [i:j]
    jme cmp32_2
    jmp cmp32_done
cmp32_2:
    inc j
    adc i, 0
    inc y
    adc x, 0
    lod a, [x:y]            ; byte 2
    cmp a, [i:j]
    jme cmp32_3
    jmp cmp32_done
cmp32_3:
    inc j
    adc i, 0
    inc y
    adc x, 0
    lod a, [x:y]            ; byte 3 (LSB)
    cmp a, [i:j]
cmp32_done:
    pop a, i, j, x, y
    ret

; ------------------------------------------------------------
; inc32: 32-bit value at [x:y] = value + 1
; dec32: 32-bit value at [x:y] = value - 1
; flags: C = wrap-around, Z = result is 0
; ------------------------------------------------------------
; The bytes are changed in memory from the LSB, and it stops as soon as
; one does not wrap around: most of the time only the LSB changes.
inc32:
    psh x, y
    add y, 3
    adc x, 0
    inc [x:y]               ; byte 3 (LSB)
    jmc inc32_2
    jmp inc32_end           ; Z = 0: the byte did not wrap to 0
inc32_2:
    dec y
    sbb x, 0
    inc [x:y]               ; byte 2
    jmc inc32_1
    jmp inc32_end
inc32_1:
    dec y
    sbb x, 0
    inc [x:y]               ; byte 1
    jmc inc32_0
    jmp inc32_end
inc32_0:
    dec y
    sbb x, 0
    inc [x:y]               ; byte 0 (MSB): C and Z = it wrapped to 0
inc32_end:
    pop x, y                ; pop leaves the flags alone
    ret

dec32:
    psh x, y
    add y, 3
    adc x, 0
    dec [x:y]               ; byte 3 (LSB)
    jmc dec32_2
    jmz dec32_lsb0          ; LSB now 0: the result may be 0
    jmp dec32_end
dec32_2:
    dec y
    sbb x, 0
    dec [x:y]               ; byte 2
    jmc dec32_1
    jmp dec32_nz
dec32_1:
    dec y
    sbb x, 0
    dec [x:y]               ; byte 1
    jmc dec32_0
    jmp dec32_nz
dec32_0:
    dec y
    sbb x, 0
    dec [x:y]               ; byte 0 (MSB): C = wrap-around
dec32_nz:
    clz                     ; the bytes below are now 0xFF: not 0
    jmp dec32_end
dec32_lsb0:                 ; C = 0, [x:y] = LSB
    psh a, b
    mov a, 0
    dec y
    sbb x, 0
    lod b, [x:y]            ; byte 2
    or a, b
    dec y
    sbb x, 0
    lod b, [x:y]            ; byte 1
    or a, b
    dec y
    sbb x, 0
    lod b, [x:y]            ; byte 0
    or a, b                 ; Z = bytes 0 to 2 are 0 too
    pop a, b
    clc
dec32_end:
    pop x, y
    ret

; ------------------------------------------------------------
; clr32: 32-bit value at [x:y] = 0
; ------------------------------------------------------------
clr32:
    psh a, x, y
    mov a, 0
    str [x:y], a
    inc y
    adc x, 0
    str [x:y], a
    inc y
    adc x, 0
    str [x:y], a
    inc y
    adc x, 0
    str [x:y], a
    pop a, x, y
    ret

; ------------------------------------------------------------
; tst32: tests the 32-bit value at [x:y]
; flags: Z = value is 0
; ------------------------------------------------------------
tst32:
    psh a, b, x, y
    lod a, [x:y]
    inc y
    adc x, 0
    lod b, [x:y]
    or a, b
    inc y
    adc x, 0
    lod b, [x:y]
    or a, b
    inc y
    adc x, 0
    lod b, [x:y]
    or a, b                 ; Z = all 4 bytes are 0
    pop a, b, x, y
    ret

; ------------------------------------------------------------
; min32: value at [x:y] = the smaller of the values at [x:y] and [i:j]
; max32: value at [x:y] = the larger of the values at [x:y] and [i:j]
; (unsigned)
; ------------------------------------------------------------
min32:
    cal cmp32
    jmf min32_keep          ; [x:y] < [i:j]: keep [x:y]
    cal copy32
min32_keep:
    ret

max32:
    cal cmp32
    jms max32_keep          ; [x:y] > [i:j]: keep [x:y]
    cal copy32
max32_keep:
    ret

; ------------------------------------------------------------
; gcd32: value at [x:y] = greatest common divisor of the values at
;        [x:y] and [i:j] (unsigned)
; ------------------------------------------------------------
; Same method as gcd16. The value at [i:j] does not change: the work is
; done on copies in gcd32_b and gcd32_t. Not reentrant (uses those and
; div32_rq).
.data32 gcd32_b 0               ; the 2nd number of each step
.data32 gcd32_t 0               ; copy of gcd32_b before a division

gcd32:
    psh i, j
    psh x, y
    mov x, gcd32_b.msb          ; gcd32_b = value at [i:j]
    mov y, gcd32_b.lsb
    cal copy32
    pop x, y
    mov i, gcd32_b.msb          ; [i:j] = gcd32_b from now on
    mov j, gcd32_b.lsb
gcd32_loop:
    psh x, y
    mov x, i
    mov y, j
    cal tst32
    pop x, y                    ; pop leaves Z alone
    jmz gcd32_done              ; gcd32_b = 0: the answer is at [x:y]
    psh x, y
    mov x, gcd32_t.msb          ; gcd32_t = gcd32_b
    mov y, gcd32_t.lsb
    cal copy32
    pop x, y
    cal div32                   ; gcd32_b = [x:y] mod gcd32_b
    psh i, j
    mov i, gcd32_t.msb          ; [x:y] = old gcd32_b
    mov j, gcd32_t.lsb
    cal copy32
    pop i, j
    jmp gcd32_loop
gcd32_done:
    pop i, j
    ret

; ------------------------------------------------------------
; isqrt32: value at [x:y] = square root of the value, rounded down
;          (0 to 65535), and the value at [i:j] = remainder
;          (value - root * root, 0 to 131070)
; flags: Z = the input was a perfect square (remainder 0)
; ------------------------------------------------------------
; Same method as isqrt16, with 16 rounds: the input is shifted in
; isqrt32_n, the remainder is [a:b:c] (24 bits), the root is [i:j], and
; root * 2 + 1 is [d:x:y]. [x:y] and [i:j] must not be the same address.
; Not reentrant (uses isqrt32_n, isqrt32_r and isqrt32_k).
.data32 isqrt32_n 0             ; input, shifted out 2 bits per round
.data32 isqrt32_r 0             ; remainder
.data isqrt32_k 0               ; rounds left

isqrt32:
    psh a, b, c, d, i, j, x, y
    mov i, x                    ; isqrt32_n = input
    mov j, y
    mov x, isqrt32_n.msb
    mov y, isqrt32_n.lsb
    cal copy32
    mov a, 0                    ; [a:b:c] = remainder
    mov b, 0
    mov c, 0
    mov i, 0                    ; [i:j] = root
    mov j, 0
    mov d, 16                   ; one round per root bit
    str isqrt32_k, d
isqrt32_loop:
    lod d, isqrt32_n + 3        ; [a:b:c : input] <<= 1, twice
    add d, d                    ; (lod and str leave C alone)
    str isqrt32_n + 3, d
    lod d, isqrt32_n + 2
    adc d, d
    str isqrt32_n + 2, d
    lod d, isqrt32_n + 1
    adc d, d
    str isqrt32_n + 1, d
    lod d, isqrt32_n
    adc d, d
    str isqrt32_n, d
    adc c, c
    adc b, b
    adc a, a
    lod d, isqrt32_n + 3
    add d, d
    str isqrt32_n + 3, d
    lod d, isqrt32_n + 2
    adc d, d
    str isqrt32_n + 2, d
    lod d, isqrt32_n + 1
    adc d, d
    str isqrt32_n + 1, d
    lod d, isqrt32_n
    adc d, d
    str isqrt32_n, d
    adc c, c
    adc b, b
    adc a, a
    add j, j                    ; root *= 2
    adc i, i
    mov d, 0                    ; [d:x:y] = root * 2 + 1
    mov x, i
    mov y, j
    add y, y
    adc x, x
    adc d, 0
    or y, 1
    sub c, y                    ; remainder -= root * 2 + 1
    sbb b, x
    sbb a, d
    jmc isqrt32_undo            ; it was smaller: undo
    or j, 1                     ; root bit = 1
    jmp isqrt32_next
isqrt32_undo:
    add c, y
    adc b, x
    adc a, d
isqrt32_next:
    dec isqrt32_k
    jmz isqrt32_done
    jmp isqrt32_loop
isqrt32_done:
    mov d, 0                    ; isqrt32_r = remainder
    str isqrt32_r, d
    str isqrt32_r + 1, a
    str isqrt32_r + 2, b
    str isqrt32_r + 3, c
    str isqrt32_n, d            ; isqrt32_n = root
    str isqrt32_n + 1, d
    str isqrt32_n + 2, i
    str isqrt32_n + 3, j
    pop a, b, c, d, i, j, x, y
    psh i, j
    mov i, isqrt32_n.msb        ; [x:y] = root
    mov j, isqrt32_n.lsb
    cal copy32
    pop i, j
    psh i, j, x, y
    mov x, i                    ; [i:j] = remainder
    mov y, j
    mov i, isqrt32_r.msb
    mov j, isqrt32_r.lsb
    cal copy32
    cal tst32                   ; Z = remainder is 0
    pop i, j, x, y              ; pop leaves Z alone
    ret
