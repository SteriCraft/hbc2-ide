; ------------------------------------------------------------
; cmp32s: compares the 32-bit values at [x:y] and [i:j] (signed), like cmp
; flags: S = [x:y] > [i:j], E = equal, F = [x:y] < [i:j]
; ------------------------------------------------------------
cmp32s:
    psh a, b
    lod a, [x:y]            ; MSBs with flipped sign bits
    xor a, 0x80
    lod b, [i:j]
    xor b, 0x80
    cmp a, b
    pop a, b                ; pop leaves S, E and F alone
    jme cmp32               ; same MSB: cmp32 returns to our caller
    ret

; ------------------------------------------------------------
; add32s: 32-bit value at [x:y] += 32-bit value at [i:j] (signed)
; flags: C = signed overflow, Z = result is 0
; ------------------------------------------------------------
add32s:
    psh a, b, c
    lod a, [x:y]            ; MSB of op1
    lod b, [i:j]            ; MSB of op2
    cal add32               ; Z is already right
    psf
    lod c, [x:y]            ; MSB of the result
    xor a, c
    xor b, c
    and a, b                ; bit 7 = overflow
    and a, 0x80
    pof                     ; back to the Z of add32
    clc                     ; cmp leaves Z alone
    cmp a, 0
    jme add32s_end
    stc
add32s_end:
    pop a, b, c
    ret

; ------------------------------------------------------------
; sub32s: 32-bit value at [x:y] -= 32-bit value at [i:j] (signed)
; flags: C = signed overflow, Z = result is 0
; ------------------------------------------------------------
sub32s:
    psh a, b, c
    lod a, [x:y]            ; MSB of op1
    lod b, [i:j]            ; MSB of op2
    cal sub32
    psf
    lod c, [x:y]            ; MSB of the result
    xor b, a                ; op1 ^ op2
    xor a, c                ; op1 ^ result
    and a, b
    and a, 0x80
    pof
    clc
    cmp a, 0
    jme sub32s_end
    stc
sub32s_end:
    pop a, b, c
    ret