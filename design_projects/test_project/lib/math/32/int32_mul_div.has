; ------------------------------------------------------------
; mul32s: 32-bit value at [x:y] *= 32-bit value at [i:j] (signed)
; flags: C = overflow (the product is outside -2^31..2^31-1; its low
;        32 bits are stored)
; ------------------------------------------------------------
; Multiplies the absolute values, then negates the product if the signs
; differ. A product of 2^31 or more only fits when it is exactly 2^31 and
; negative; neg32 detects exactly that case (it sets C for 0x80000000).
; |op2| is made in a copy on the stack: the value at [i:j] does not change.
mul32s:
    psh a, b, c, i, j
    lod a, [x:y]
    xor a, [i:j]                ; bit 7 = sign of the product
    ssp 4                       ; [sp] = copy of op2
    lod b, [i:j]
    str [sp], b
    lod b, [i:j + 1]
    str [sp + 1], b
    lod b, [i:j + 2]
    str [sp + 2], b
    lod b, [i:j + 3]
    str [sp + 3], b
    rsp [i:j]                   ; [i:j] -> the copy
    psh x, y
    mov x, i
    mov y, j
    cal abs32                   ; copy = |op2|
    pop x, y
    cal abs32                   ; [x:y] = |op1|
    cal mul32                   ; C = more than 32 bits
    mov b, 1                    ; b = overflow (mov leaves C alone)
    jmc mul32s_sign
    mov b, 0
    lod c, [x:y]
    and c, 0x80
    jmz mul32s_sign             ; below 2^31: fits
    mov b, 1
    mov c, a
    and c, 0x80
    jmz mul32s_sign             ; 2^31 or more and positive: overflow
    cal neg32                   ; negative: fits only if exactly 2^31
    jmc mul32s_fits
    jmp mul32s_flag
mul32s_fits:
    mov b, 0
    jmp mul32s_flag
mul32s_sign:
    and a, 0x80
    jmz mul32s_flag
    cal neg32
mul32s_flag:
    clc
    cmp b, 0
    jme mul32s_end
    stc
mul32s_end:
    asp 4                       ; asp leaves the flags alone
    pop a, b, c, i, j
    ret

; ------------------------------------------------------------
; div32s: 32-bit value at [x:y] /= 32-bit value at [i:j] (signed),
;         and the value at [i:j] = remainder
; flags: C = division by zero, or -2^31 / -1; then nothing changes
; ------------------------------------------------------------
; Same rules as div16s.
div32s:
    psh a, b
    lod a, [i:j]
    or a, [i:j + 1]
    or a, [i:j + 2]
    or a, [i:j + 3]
    jmz div32s_err              ; division by zero
    lod a, [x:y]
    cmp a, 0x80
    jme div32s_min_check        ; -2^31 / -1?
div32s_ok:
    lod a, [x:y]                ; bit 7 = sign of the remainder
    lod b, [i:j]
    xor b, a                    ; bit 7 = sign of the quotient
    cal abs32
    psh x, y
    mov x, i
    mov y, j
    cal abs32
    pop x, y
    cal div32
    and b, 0x80
    jmz div32s_rem
    cal neg32
div32s_rem:
    and a, 0x80
    jmz div32s_end
    psh x, y
    mov x, i
    mov y, j
    cal neg32
    pop x, y
div32s_end:
    pop a, b
    clc
    ret
div32s_min_check:               ; MSB = 0x80
    lod a, [x:y + 1]
    or a, [x:y + 2]
    or a, [x:y + 3]
    jmz div32s_min_m1           ; dividend = -2^31
    jmp div32s_ok
div32s_min_m1:
    lod a, [i:j]                ; divisor = -1: all bytes 0xFF
    and a, [i:j + 1]
    and a, [i:j + 2]
    and a, [i:j + 3]
    cmp a, 0xFF
    jme div32s_err
    jmp div32s_ok
div32s_err:
    pop a, b
    stc
    ret
