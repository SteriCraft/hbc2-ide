; === DEFINES ===
; - IOD interrupt handler -
.define MONITOR_ID 0x4A
.define KEYBOARD_ID 0xAA
.define RTC_ID 0x95
.define EEPROM_ID 0xE1


; === VARIABLES ===
; - IOD interrupt handler -
.data IOD_INT_HANDLER_ADDR $0xFE00 _iod_interrupt_handler.msb, _iod_interrupt_handler.lsb  ; Interrupt vector of port 0
.data firstInterrupt 0x00   ; IOD sends 2 interrupts when a peripheral is plugged, 1: First connected port, 2: ID
.data pendingPort 0x00      ; First connected port, kept between the 2 interrupts
.data monitorPort 0x00      ; First connected port for each peripheral
.data keyboardPort 0x00
.data rtcPort 0x00
.data eepromPort 0x00


; === PROGRAM ===
; An interrupt can happen between any two instructions of the main program,
; and only I and PC are saved by the CPU. So the handler saves everything
; else it changes (flags first, as most instructions change them) and
; restores it before IRT.
_iod_interrupt_handler: $0xF000
    psf                             ; Save the main program's flags
    psh a                           ; Save 'A', used below

    lod a, firstInterrupt           ; Check if we are handling the first or the second IOD interrupt
    cmp a, 1
    jme _iod_interrupt_handler_id   ; Jump if managing the second interrupt

    str pendingPort, i              ; First interrupt: 'I' holds the first connected port
    mov a, 1
    str firstInterrupt, a           ; Prepare for the second interrupt
    jmp _iod_interrupt_handler_end

_iod_interrupt_handler_id:
    lod a, pendingPort              ; 'A' = the peripheral's first port, 'I' = its ID

    cmp i, MONITOR_ID
    jme _iod_interrupt_handler_monitor_plugged

    cmp i, KEYBOARD_ID
    jme _iod_interrupt_handler_keyboard_plugged

    cmp i, RTC_ID
    jme _iod_interrupt_handler_rtc_plugged

    cmp i, EEPROM_ID
    jme _iod_interrupt_handler_eeprom_plugged

    ; Reaching this point means the peripheral wasn't recognized. Interrupt discarded.
    jmp _iod_interrupt_handler_id_done

_iod_interrupt_handler_monitor_plugged:
    str monitorPort, a
    jmp _iod_interrupt_handler_id_done

_iod_interrupt_handler_keyboard_plugged:
    str keyboardPort, a
    psh x                           ; The keyboard interrupts on each key, on 2 ports
    psh y                           ; (pressed, released): point both vectors to a
    mov x, 0xFE                     ; default handler, so keys are ignored until the
    mov y, a                        ; program installs its own.
    shl y                           ; [x:y] = IVT entry of the first port = $0xFE00 + 2 * port
    jmc _iod_interrupt_handler_keyboard_high_port
    jmp _iod_interrupt_handler_keyboard_vector
_iod_interrupt_handler_keyboard_high_port:
    inc x                           ; Port 128 or more: entry in $0xFFxx
_iod_interrupt_handler_keyboard_vector:
    mov a, _keyboard_default_handler.msb
    str [x:y], a
    inc y
    mov a, _keyboard_default_handler.lsb
    str [x:y], a
    inc y                           ; Second port: the next entry
    cmp y, 0
    jme _iod_interrupt_handler_keyboard_second_high
    jmp _iod_interrupt_handler_keyboard_second
_iod_interrupt_handler_keyboard_second_high:
    inc x                           ; First port 127: the second entry is $0xFF00
_iod_interrupt_handler_keyboard_second:
    mov a, _keyboard_default_handler.msb
    str [x:y], a
    inc y
    mov a, _keyboard_default_handler.lsb
    str [x:y], a
    pop y
    pop x
    jmp _iod_interrupt_handler_id_done

_iod_interrupt_handler_rtc_plugged:
    str rtcPort, a
    psh x                           ; The RTC interrupts every second: point its vector
    psh y                           ; to a default handler, so it is ignored until the
    mov x, 0xFE                     ; program installs its own.
    mov y, a                        ; [x:y] = IVT entry of the port = $0xFE00 + 2 * port
    shl y
    jmc _iod_interrupt_handler_rtc_high_port
    jmp _iod_interrupt_handler_rtc_vector
_iod_interrupt_handler_rtc_high_port:
    inc x                           ; Port 128 or more: entry in $0xFFxx
_iod_interrupt_handler_rtc_vector:
    mov a, _rtc_default_handler.msb
    str [x:y], a
    inc y
    mov a, _rtc_default_handler.lsb
    str [x:y], a
    pop y
    pop x
    jmp _iod_interrupt_handler_id_done

_iod_interrupt_handler_eeprom_plugged:
    str eepromPort, a

_iod_interrupt_handler_id_done:
    mov a, 0
    str firstInterrupt, a           ; Prepare for a future IOD interrupt

_iod_interrupt_handler_end:
    pop a                           ; Restore in reverse order
    pof
    irt

; Default RTC handler: does nothing. To use the RTC, write your own handler
; and store its address in the IVT entry of rtcPort.
_rtc_default_handler:
    irt

; Default keyboard handler: does nothing. To use the keyboard, write your own
; handlers and store their addresses in the IVT entries of keyboardPort
; (key pressed) and keyboardPort + 1 (key released).
_keyboard_default_handler:
    irt
